---
const isPreview = import.meta.env.SITE_ENV === 'preview';
---
<header class="site-header approved-header">
  <a class="brand" href="/" aria-label="Broker Pal home">
    <img src="/broker-pal-logo.svg" alt="Broker Pal — DSCR and Investment Loans" width="280" height="64" fetchpriority="high" />
  </a>
  <nav aria-label="Main navigation">
    <a href="/" aria-label="Home">Home</a>
    <a href="/#loan-programs">Loan Programs</a>
    <a href="/tools">Tools</a>
    <a href="/how-it-works">Resources</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    {!isPreview && <a class="staff-nav-link" href="https://yourbrokerpal-los--dscr.pages.dev/api/staff/loans?login=1">Staff Sign-in</a>}
    <a class="nav-cta" href="/apply">Apply Now <span aria-hidden="true">→</span></a>
  </nav>
</header>
<style>
.site-header{width:100%;box-sizing:border-box;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:24px}
.approved-header{max-width:none;padding:15px max(5.1vw,28px);background:#002447;border-bottom:1px solid #16466b}
.approved-header .brand{display:flex;align-items:center;flex:0 0 auto;text-decoration:none}
.approved-header .brand::before,.approved-header .brand::after{content:none!important;display:none!important}
.approved-header .brand img{object-fit:contain}
.approved-header .brand img{display:block;width:clamp(220px,23vw,280px);height:auto;max-width:100%}
.approved-header nav{display:flex;align-items:center;justify-content:flex-end;gap:clamp(12px,1.55vw,23px);flex-wrap:wrap}
.approved-header nav a{font-size:14px;font-weight:700;color:#f5f8fb;text-decoration:none;white-space:nowrap}
.approved-header nav a:hover,.approved-header nav a:focus-visible{color:#18d0d0}
.approved-header nav .staff-nav-link{font-size:11px;color:#a9dfe0;text-decoration:underline;text-underline-offset:4px}
.approved-header nav .nav-cta{border-radius:26px;background:#18d0d0;color:#002447;padding:11px 21px;font-size:14px}
.approved-header nav .nav-cta:hover,.approved-header nav .nav-cta:focus-visible{background:#64e5e0;color:#002447}
@media(max-width:1050px){.approved-header{align-items:flex-start;flex-direction:column;gap:12px}.approved-header nav{justify-content:flex-start;gap:10px 18px}}
@media(max-width:560px){.approved-header{padding:13px 17px}.approved-header .brand img{width:230px}.approved-header nav{gap:9px 14px}.approved-header nav a{font-size:12px}.approved-header nav .staff-nav-link{font-size:10px}.approved-header nav .nav-cta{padding:9px 15px;font-size:12px}}
</style>
