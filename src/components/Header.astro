---
import HeaderLink from './HeaderLink.astro';
---
<header class="site-header">
  <a class="brand" href="/" aria-label="YourBrokerPal home">
    <img src="/broker-pal-logo.svg" alt="YourBrokerPal — DSCR Investment Financing" width="248" height="56" />
  </a>
  <nav aria-label="Main navigation">
    <HeaderLink href="/">Home</HeaderLink>
    <HeaderLink href="/how-it-works">How It Works</HeaderLink>
    <HeaderLink href="/about">About</HeaderLink>
    <HeaderLink href="/contact">Contact</HeaderLink>
    <a class="nav-cta" href="/apply">Apply Now <span aria-hidden="true">↗</span></a>
  </nav>
</header>
<style>
.site-header{max-width:1180px;margin:auto;padding:18px 28px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:inline-flex;align-items:center;text-decoration:none;flex:0 0 auto}.brand img{display:block;width:248px;height:auto;max-width:100%}.site-header nav{display:flex;align-items:center;gap:28px}.site-header nav a{color:#40536a;text-decoration:none;font-size:14px;font-weight:650}.site-header nav a.active{color:#b48745}.site-header nav .nav-cta{background:#c69b59;color:#10243c;padding:12px 19px;border-radius:5px}.nav-cta span{margin-left:7px}@media(max-width:700px){.site-header{padding:14px 18px;align-items:flex-start;flex-direction:column;gap:12px}.brand img{width:218px}.site-header nav{width:100%;gap:15px;flex-wrap:wrap}.site-header nav a{font-size:13px}.site-header nav .nav-cta{padding:9px 13px}}
</style>