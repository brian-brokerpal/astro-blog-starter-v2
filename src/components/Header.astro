---
import HeaderLink from './HeaderLink.astro';
---
<header class="site-header approved-header">
  <a class="brand" href="/" aria-label="Broker Pal home"><img src="/broker-pal-logo.svg" alt="Broker Pal — DSCR and Investment Loans" width="280" height="64" fetchpriority="high" /></a>
  <nav aria-label="Main navigation">
    <a class="active" href="/">Home</a>
    <a href="/#loan-programs">Loan Programs⌄</a>
    <a href="/investor">Investor Guide</a>
    <a href="/llc-guide">LLC Guide</a>
    <a href="/tools">Tools⌄</a>
    <a href="/investor-zone">Investors</a>
    <a href="/realtor-studio">Realtors</a>
    <a href="/how-it-works">Resources⌄</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a class="staff-nav-link" href="https://yourbrokerpal-los--dscr.pages.dev/api/staff/loans?login=1">Staff Sign-in</a>
    <a class="nav-cta" href="/apply">Apply Now <span>→</span></a>
  </nav>
</header>
<style>
.site-header{max-width:1240px;margin:auto;padding:20px 34px;display:flex;align-items:center;justify-content:space-between;gap:24px;background:#071827}
.brand{display:flex;align-items:center;flex:0 0 auto;text-decoration:none;line-height:1}
.brand img{display:block;width:clamp(220px,23vw,280px);height:auto;max-width:100%;object-fit:contain}
.site-header nav{display:flex;align-items:center;gap:clamp(12px,1.8vw,24px)}
.site-header nav a{color:#d3e0e6;text-decoration:none;font-size:13px;font-weight:700;white-space:nowrap}
.site-header nav a:hover,.site-header nav a.active{color:#65d4c8}
.site-header nav .staff-nav-link{color:#65d4c8;font-size:12px;font-weight:800;text-decoration:underline;text-underline-offset:4px;white-space:nowrap}
.site-header nav .nav-cta{background:#55cbbf;color:#071d2c;padding:12px 18px;border-radius:4px}
.site-header nav .nav-cta:hover{background:#79e0d5;color:#071d2c}
.nav-cta span{margin-left:7px}
@media(max-width:900px){.site-header{padding:18px 24px;align-items:flex-start;flex-direction:column}.site-header nav{width:100%;gap:13px;flex-wrap:wrap}.site-header nav a{font-size:12px}.site-header nav .nav-cta{padding:9px 13px}.site-header nav .staff-nav-link{font-size:11px}.brand img{width:230px}}
@media(max-width:460px){.site-header{padding:16px 18px}.site-header nav{gap:10px 13px}}
</style>
<style>
.approved-header{max-width:none;width:100%;box-sizing:border-box;padding:18px max(5.1vw,28px);background:#002447;border-bottom:1px solid #16466b;display:flex;align-items:center;justify-content:space-between;gap:28px}.approved-header .brand img{width:clamp(220px,23vw,280px)}.approved-header .brand{gap:0}.approved-header .brand img{max-width:100%}.approved-header nav{display:flex;align-items:center;gap:clamp(15px,2.1vw,32px)}.approved-header nav a{font-size:15px;font-weight:700;color:#f5f8fb;text-decoration:none}.approved-header nav a:hover,.approved-header nav a.active{color:#18d0d0}.approved-header nav a.active{border-bottom:3px solid #18d0d0;padding:8px 14px}.approved-header nav .staff-nav-link{font-size:11px;color:#8fdedc}.approved-header nav .nav-cta{border-radius:26px;background:#18d0d0;color:#002447;padding:12px 23px;font-size:15px}.approved-header nav .nav-cta:hover{background:#64e5e0;color:#002447}@media(max-width:900px){.approved-header{padding:16px 22px;flex-direction:column;align-items:flex-start}.approved-header nav{flex-wrap:wrap;gap:12px 18px}.approved-header nav a{font-size:13px}}@media(max-width:480px){.approved-header{padding:14px 18px}.approved-header .brand img{width:230px}.approved-header nav{gap:10px 14px}}
</style>
