---
import HeaderLink from './HeaderLink.astro';
---
<header class="site-header">
  <a class="brand" href="/" aria-label="broker pal — Investment Loans home">
    <span class="brand-word"><span class="broker">broker</span> <span class="pal">pal</span></span>
    <span class="brand-tagline">Investment Loans</span>
  </a>
  <nav aria-label="Main navigation">
    <HeaderLink href="/">Home</HeaderLink>
    <HeaderLink href="/how-it-works">How It Works</HeaderLink>
    <HeaderLink href="/about">About</HeaderLink>
    <a href="/tools/dscr-calculator">Tools</a>
    <a href="/community">Community</a>
    <HeaderLink href="/contact">Contact</HeaderLink>
    <a class="nav-cta" href="/apply">Apply Now <span>↗</span></a>
  </nav>
</header>
<style>
.site-header{max-width:1180px;margin:auto;padding:20px 28px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;flex-direction:column;align-items:flex-start;gap:0;text-decoration:none;line-height:1}
.brand-word{font-size:clamp(29px,3vw,39px);font-weight:850;letter-spacing:-2px;white-space:nowrap}
.broker{color:#102b49}.pal{color:#079eaa}
.brand-tagline{font-size:12px;font-weight:750;letter-spacing:.5px;color:#168b79;margin:6px 0 0 3px}
.site-header nav{display:flex;align-items:center;gap:25px}
.site-header nav a{color:#29415b;text-decoration:none;font-size:14px;font-weight:700}
.site-header nav a.active{color:#078f9d}
.site-header nav .nav-cta{background:#078f9d;color:#fff;padding:12px 19px;border-radius:5px}
.nav-cta span{margin-left:7px}
@media(max-width:700px){.site-header{padding:16px 18px;align-items:flex-start;flex-direction:column}.site-header nav{width:100%;gap:14px;flex-wrap:wrap}.site-header nav a{font-size:13px}.site-header nav .nav-cta{padding:9px 13px}.brand-word{font-size:34px}}
</style>