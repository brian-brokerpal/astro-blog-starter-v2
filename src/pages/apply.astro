---
import Layout from '../layouts/BlogPost.astro';
const isPreview = import.meta.env.SITE_ENV === 'preview';
const losApplyUrl = isPreview ? '/apply-preview' : 'https://yourbrokerpal-los--dscr.pages.dev/apply.html';
---
<Layout title="Start an Investment Loan Inquiry | Broker Pal" description="Begin an investment property loan inquiry with Broker Pal.">
  <div class="page">
    <div class="kicker">GET STARTED</div>
    <h1>Start with your property. We'll take it from there.</h1>
    <p class="lead">Tell us a little about the investment property and financing you're considering. Your inquiry will open the Broker Pal loan intake form.</p>
    <div class="apply-card">
      <h2>Start your loan inquiry</h2>
      <p>The initial form asks for basic contact information and property details so we can follow up about potential financing options.</p>
      <ul>
        <li>Your name and contact information</li>
        <li>Property address and type</li>
        <li>Purchase or refinance details</li>
        <li>Estimated property value, loan amount and monthly rent</li>
      </ul>
      <a class="button" href={losApplyUrl}>{isPreview ? "Preview Only — Live Application Disabled" : "Continue to Loan Inquiry"} <span aria-hidden="true">↗</span></a>
    </div>
    <p class="fine"><strong>Important:</strong> This is an initial inquiry, not a credit application, approval, or commitment to lend. Do not enter Social Security numbers, dates of birth, bank account details, or upload tax returns, bank statements, or other sensitive documents. The intake form is hosted separately by Broker Pal's loan system.</p>
    <p class="contact">Questions? <a href="mailto:brian@yourbrokerpal.com">brian@yourbrokerpal.com</a> · <a href="tel:4046062943">404-606-2943</a></p>
  </div>
</Layout>
<style>
.page{max-width:800px;margin:auto;padding:35px 28px 70px}.kicker{font-size:11px;letter-spacing:2px;color:#078f9d;font-weight:800}.page h1{font-size:clamp(38px,5vw,56px);line-height:1.08;letter-spacing:-2px;color:#102b49;margin:20px 0}.lead{font-size:18px;color:#617387;line-height:1.8}.apply-card{margin-top:30px;background:#edf5f6;padding:30px;border-top:4px solid #079eaa}.apply-card h2{color:#102b49;margin:0 0 8px}.apply-card p,.apply-card li{color:#52697b;font-size:15px}.apply-card ul{padding-left:22px;line-height:2;margin:20px 0}.button{display:inline-flex;align-items:center;gap:18px;background:#078f9d;color:#fff;text-decoration:none;font-weight:800;padding:14px 20px;border-radius:4px}.fine{font-size:13px;color:#687b8c;margin-top:20px;line-height:1.7}.contact{font-size:14px;color:#52697b;margin-top:24px}.contact a{color:#078f9d;font-weight:700}
</style>
