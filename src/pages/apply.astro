---
import Layout from '../layouts/BlogPost.astro';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<Layout title="Start an Investment Loan Inquiry | Broker Pal" description="Send Broker Pal an initial investment property financing inquiry.">
  <main class="apply-page">
    <div class="apply-kicker">GET STARTED · INVESTMENT LOANS</div>
    <h1>Tell us about your financing plans.</h1>
    <p class="apply-lead">Start with a few details. Your inquiry will be sent securely to Broker Pal's Lead Center so we can follow up about potential financing options.</p>
    <form id="financing-inquiry-form" class="apply-card">
      <h2>Your contact information</h2>
      <div class="apply-grid">
        <label>First name *<input name="firstName" required maxlength="80" autocomplete="given-name"></label>
        <label>Last name<input name="lastName" maxlength="80" autocomplete="family-name"></label>
        <label>Email address<input name="email" type="email" maxlength="254" autocomplete="email"></label>
        <label>Phone number<input name="phone" type="tel" maxlength="40" autocomplete="tel"></label>
        <label class="full">Borrowing entity (optional)<input name="entityName" maxlength="160" placeholder="LLC or company name"></label>
      </div>
      <hr>
      <h2>What type of financing are you looking for?</h2>
      <div class="apply-grid">
        <label>Loan program *
          <select name="programInterest" required>
            <option value="DSCR Rental Loans">DSCR rental loan</option>
            <option value="Fix & Flip Loans">Fix &amp; flip</option>
            <option value="Bridge Loans">Bridge loan</option>
            <option value="Commercial & Business Purpose">Commercial / business purpose</option>
            <option value="Not sure — help me compare">Not sure — help me compare</option>
          </select>
        </label>
        <label>Loan purpose *
          <select name="loanPurpose" required>
            <option>Purchase</option>
            <option>Rate &amp; term refinance</option>
            <option>Cash-out refinance</option>
          </select>
        </label>
      </div>
      <hr>
      <h2>Property details</h2>
      <p class="apply-hint">If you have a property identified, share what you know. You can still submit if you are evaluating a purchase and do not have an address yet.</p>
      <div class="apply-grid">
        <label class="full">Property street address (optional)<input name="propertyAddress" maxlength="300" autocomplete="street-address"></label>
        <label>City<input name="propertyCity" maxlength="100" autocomplete="address-level2"></label>
        <label>State<input name="propertyState" maxlength="2" pattern="[A-Za-z]{2}" placeholder="GA" autocomplete="address-level1"></label>
        <label>ZIP code<input name="propertyZip" maxlength="12" pattern="[0-9]{5}(-?[0-9]{4})?" inputmode="numeric" autocomplete="postal-code"></label>
        <label>Property type
          <select name="propertyType">
            <option value="">Select if known</option>
            <option value="Single-family rental">Single-family rental</option>
            <option value="2–4 Unit">2–4 Unit</option>
            <option value="5+ Unit / Multifamily">5+ Unit / Multifamily</option>
            <option value="Condominium">Condominium</option>
            <option value="Townhome">Townhome</option>
            <option value="Other">Other</option>
          </select>
        </label>
        <label>Number of units<input name="units" type="number" min="1" max="500" step="1" value="1"></label>
        <label>Purchase price ($)<input name="purchasePrice" type="number" min="0" step="0.01" inputmode="decimal"></label>
        <label>Estimated property value ($)<input name="estimatedValue" type="number" min="0" step="0.01" inputmode="decimal"></label>
        <label>Requested loan amount ($)<input name="requestedAmount" type="number" min="0" step="0.01" inputmode="decimal"></label>
        <label>Estimated monthly market rent ($)<input name="monthlyMarketRent" type="number" min="0" step="0.01" inputmode="decimal"></label>
      </div>
      <label class="apply-message">Anything else we should know? (optional)<textarea name="message" rows="4" maxlength="3500" placeholder="Timing, property status, renovation plans, or questions..."></textarea></label>
      <div id="apply-turnstile" class="turnstile" data-sitekey={siteKey}></div>
      <p id="apply-status" class="apply-status" role="status" aria-live="polite">Provide an email address or phone number so we can respond to your inquiry.</p>
      <button id="apply-submit" class="apply-primary" type="submit" disabled>Send my financing inquiry</button>
      <p class="apply-consent">By submitting, you ask Broker Pal to contact you about this inquiry using the contact information you provide. This is not consent to automated marketing calls or text messages.</p>
      <p class="apply-disclaimer">This is an initial inquiry, not a credit application, loan approval, commitment to lend, rate lock, or guarantee of terms. Do not submit Social Security numbers, dates of birth, bank account details, passwords, tax returns, or bank statements through this form. If documents are needed, Broker Pal will provide secure instructions. Information may be shared with prospective lending partners as reasonably necessary to evaluate and process the financing request.</p>
    </form>
    <section id="apply-success" class="apply-card apply-success" hidden>
      <h2>Your inquiry has been received.</h2>
      <p>Reference number: <strong id="apply-reference"></strong></p>
      <p>A Broker Pal team member can follow up using the contact information you provided.</p>
      <a class="apply-secondary" href="/">Return to Broker Pal</a>
    </section>
    <p class="apply-contact">Questions? <a href="mailto:brian@yourbrokerpal.com">brian@yourbrokerpal.com</a> · <a href="tel:4046062943">404-606-2943</a></p>
  </main>
</Layout>

<script define:vars={{ siteKey }}>
const form=document.getElementById('financing-inquiry-form');
const statusEl=document.getElementById('apply-status');
const submitButton=document.getElementById('apply-submit');
const success=document.getElementById('apply-success');
const turnstileTarget=document.getElementById('apply-turnstile');
let turnstileToken='',turnstileWidget=null,turnstileLoading=false;
const storageKey='brokerpal_financing_inquiry_submission_key';
function makeKey(){return crypto.randomUUID();}
function getKey(){try{const value=sessionStorage.getItem(storageKey)||'';if(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value))return value;}catch{}const value=makeKey();try{sessionStorage.setItem(storageKey,value);}catch{}return value;}
let submissionKey=getKey();
function renderTurnstile(){
 if(!siteKey){statusEl.textContent='Secure online inquiry submission is not configured. Please contact Broker Pal directly.';return;}
 const render=()=>{if(!window.turnstile||turnstileWidget!==null)return;turnstileWidget=window.turnstile.render(turnstileTarget,{sitekey:siteKey,callback:token=>{turnstileToken=token;submitButton.disabled=false;statusEl.textContent='Security check complete. Ready to submit.';},'expired-callback':()=>{turnstileToken='';submitButton.disabled=true;statusEl.textContent='Security check expired. Please complete it again.';},'error-callback':()=>{turnstileToken='';submitButton.disabled=true;statusEl.textContent='Security check could not be completed. Refresh and try again.';}});};
 if(window.turnstile){render();return;}
 if(turnstileLoading)return;
 turnstileLoading=true;const script=document.createElement('script');script.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';script.async=true;script.defer=true;script.onload=render;script.onerror=()=>{statusEl.textContent='The security check could not load. Please refresh and try again.';};document.head.appendChild(script);
}
renderTurnstile();
form.addEventListener('submit',async event=>{
 event.preventDefault();
 const data=new FormData(form),email=String(data.get('email')||'').trim(),phone=String(data.get('phone')||'').trim();
 if(!email&&!phone){statusEl.textContent='Please provide an email address or phone number.';form.elements.email.focus();return;}
 if(!turnstileToken){statusEl.textContent='Complete the security check before submitting.';return;}
 const propertyAddress=String(data.get('propertyAddress')||'').trim(),propertyState=String(data.get('propertyState')||'').trim(),propertyCity=String(data.get('propertyCity')||'').trim(),propertyZip=String(data.get('propertyZip')||'').trim();
 if((propertyAddress||propertyCity||propertyState||propertyZip)&&(!propertyCity||!/^[A-Za-z]{2}$/.test(propertyState))){statusEl.textContent='If you enter a property location, include its city and two-letter state.';return;}
 if(propertyZip&&!/^\d{5}(?:-?\d{4})?$/.test(propertyZip)){statusEl.textContent='Enter a valid property ZIP code or leave it blank.';return;}
 const body={firstName:data.get('firstName'),lastName:data.get('lastName'),email,phone,entityName:data.get('entityName'),leadType:'financing_inquiry',propertyAddress:data.get('propertyAddress'),propertyCity,propertyState:propertyState.toUpperCase(),propertyZip,propertyType:data.get('propertyType'),loanPurpose:data.get('loanPurpose'),units:data.get('units'),purchasePrice:data.get('purchasePrice'),estimatedValue:data.get('estimatedValue'),requestedAmount:data.get('requestedAmount'),monthlyMarketRent:data.get('monthlyMarketRent'),programInterest:data.get('programInterest'),message:data.get('message'),campaign:'Website Apply Inquiry',websitePath:'/apply',submissionKey,turnstileToken,...(window.BrokerPalAttribution||{})};
 submitButton.disabled=true;statusEl.textContent='Sending your inquiry securely…';
 try{
  const response=await fetch('/api/public-leads',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});
  const result=await response.json().catch(()=>({}));
  if(!response.ok)throw new Error(result.error||'We could not submit your inquiry. Please try again.');
  document.getElementById('apply-reference').textContent=result.reference||'Received';
  form.hidden=true;success.hidden=false;
  try{sessionStorage.removeItem(storageKey);}catch{}
 }catch(error){statusEl.textContent=error.message||'Please try again.';turnstileToken='';if(window.turnstile&&turnstileWidget!==null)window.turnstile.reset(turnstileWidget);submitButton.disabled=true;}
});
</script>

<style>
.apply-page{max-width:900px;margin:0 auto;padding:42px 22px 70px;color:#183047}
.apply-kicker{font-size:11px;letter-spacing:2px;font-weight:800;color:#078f9d}
.apply-page h1{font-size:clamp(34px,5vw,52px);line-height:1.1;letter-spacing:-1.7px;color:#102b49;margin:14px 0}
.apply-lead{font-size:17px;color:#5c7083;line-height:1.7;max-width:720px;margin:0 0 28px}
.apply-card{background:#fff;border:1px solid #dce5eb;border-radius:10px;padding:clamp(18px,3vw,30px);box-shadow:0 8px 28px rgba(16,43,73,.07);margin:20px 0}
.apply-card h2{font-size:21px;color:#102b49;margin:0 0 18px}
.apply-hint{font-size:13px;color:#667b8c;margin:-8px 0 15px}
.apply-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
.apply-grid label,.apply-message{display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:700;color:#334d63}
.apply-grid input,.apply-grid select,.apply-message textarea{width:100%;box-sizing:border-box;border:1px solid #c8d5de;border-radius:5px;padding:12px;font:inherit;color:#19334b;background:#fff;min-height:44px}
.apply-grid input:focus,.apply-grid select:focus,.apply-message textarea:focus{outline:2px solid #64cfc5;outline-offset:1px}
.apply-grid .full,.apply-message{grid-column:1/-1}
.apply-card hr{border:0;border-top:1px solid #e4ebef;margin:25px 0}
.apply-message{margin-top:20px}
.turnstile{margin-top:18px;min-height:66px}
.apply-status{font-size:13px;color:#52697b}
.apply-primary,.apply-secondary{border:0;border-radius:5px;padding:13px 18px;font-weight:800;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}
.apply-primary{background:#078f9d;color:#fff}.apply-primary:disabled{opacity:.5;cursor:not-allowed}
.apply-secondary{background:#edf3f6;color:#183b58}
.apply-consent{font-size:13px;line-height:1.55;color:#334d63;margin:17px 0 10px}
.apply-disclaimer{font-size:12px;line-height:1.6;color:#6b7d8d;margin:12px 0 0}
.apply-success{border-top:4px solid #078f9d}
.apply-contact{font-size:13px;color:#65798a}.apply-contact a{color:#078f9d;font-weight:700}
@media(max-width:600px){.apply-grid{grid-template-columns:1fr}}
</style>
