---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<!doctype html>
<html lang="en">
<head><BaseHead title="Investor Zone | Broker Pal" description="A workspace for real estate investors to organize property activity and connect with financing and transaction resources." /></head>
<body><Header />
<main class="page">
  <section class="hero"><div class="eyebrow">BROKER PAL INVESTOR ZONE</div><h1>Your portfolio. Your next move. <em>One connected place.</em></h1><p>Bring your investment activity into focus, find useful transaction resources, and connect with financing guidance when you're ready.</p><a class="button" href="#investor-inquiry">Talk financing with Broker Pal <span>→</span></a></section>
  <section class="features"><article><span>01</span><h2>Property overview</h2><p>Keep property details, acquisition notes, and important milestones organized in one investor workspace.</p></article><article><span>02</span><h2>Transaction resources</h2><p>Build a reliable circle of real estate professionals, from agents and title teams to attorneys and tax advisors.</p></article><article><span>03</span><h2>Financing conversations</h2><p>Explore DSCR rental, fix-and-flip, bridge, and commercial financing options based on your next project.</p></article></section>
  <section class="realtor"><div><div class="eyebrow">YOUR REAL ESTATE TEAM</div><h2>Already working with a Realtor?</h2><p>We want to respect the relationships you've already built—and help when you need a connection.</p></div><div class="choice"><p><b>Do you already have a Realtor?</b></p><label><input type="radio" name="realtorStatus" value="yes"> Yes, I have a Realtor</label><label><input type="radio" name="realtorStatus" value="no"> No, not currently</label><label><input type="radio" name="realtorStatus" value="need_referral"> I'd like a Realtor referral</label><small>If you request an introduction, we'll ask for your permission before sharing your contact information with an agent.</small></div></section>
  <section class="form-section" id="investor-inquiry"><div><div class="eyebrow">FINANCING INQUIRY</div><h2>Have a property or financing question?</h2><p>Tell us a little about your plans. This is an inquiry—not a loan application or credit authorization.</p><ul><li>DSCR rental property financing</li><li>Fix &amp; flip and bridge loans</li><li>Commercial and business-purpose financing</li></ul></div>
    <form id="investorLead" data-page="/investor-zone" data-lead-type="financing">
      <div class="fields"><label>First name<input name="firstName" autocomplete="given-name" required maxlength="80"></label><label>Last name<input name="lastName" autocomplete="family-name" required maxlength="80"></label><label>Email<input type="email" name="email" autocomplete="email" maxlength="254"></label><label>Phone<input type="tel" name="phone" autocomplete="tel" maxlength="40"></label><label class="wide">Financing interest<select name="programInterest"><option value="DSCR rental">DSCR rental</option><option value="Fix and flip">Fix &amp; flip</option><option value="Bridge loan">Bridge loan</option><option value="Commercial / business purpose">Commercial / business purpose</option><option value="Not sure yet">Not sure yet</option></select></label><label class="wide">What are you working on?<textarea name="message" rows="3" maxlength="1000"></textarea></label></div>
      <input type="hidden" name="hasRealtor" id="hasRealtor" value=""><div class="consent-row"><input type="checkbox" id="referralConsent" name="referralConsent"><label for="referralConsent">I authorize Broker Pal to contact me about a Realtor introduction if I selected that I would like a referral. My information will not be shared with an agent unless I request and authorize an introduction.</label></div>
      <div class="turnstile" data-sitekey={siteKey}></div><button type="submit">Send my inquiry <span>→</span></button><p class="status" role="status" aria-live="polite"></p><small>By submitting, you agree Broker Pal may contact you about this inquiry. No automated marketing calls or texts are authorized by this form.</small>
    </form>
  </section>
</main><Footer />
<script is:inline define:vars={{siteKey}}>
const form=document.querySelector('#investorLead');
const status=form?.querySelector('.status');
const statusChoice=document.querySelectorAll('input[name="realtorStatus"]');
const hasRealtor=document.querySelector('#hasRealtor');
const consent=document.querySelector('#referralConsent');
const submit=form?.querySelector('button[type="submit"]');
let turnstileToken='';
function loadTurnstile(){
 if(!siteKey){status.textContent='Secure inquiry submission is being configured. Please use the Contact page in the meantime.';submit.disabled=true;return;}
 const s=document.createElement('script');s.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';s.async=true;s.defer=true;s.onload=()=>{if(window.turnstile){window.turnstile.render(form.querySelector('.turnstile'),{sitekey:siteKey,callback:t=>turnstileToken=t,'expired-callback':()=>turnstileToken=''});}};document.head.appendChild(s);
}
statusChoice.forEach(el=>el.addEventListener('change',()=>{hasRealtor.value=document.querySelector('input[name="realtorStatus"]:checked')?.value||'';consent.required=hasRealtor.value==='need_referral';}));
loadTurnstile();
form?.addEventListener('submit',async e=>{e.preventDefault();status.textContent='';const d=new FormData(form);const referral=hasRealtor.value==='need_referral';if(referral&&!consent.checked){status.textContent='Please authorize an introduction before requesting a Realtor referral.';return;}if(!d.get('email')&&!d.get('phone')){status.textContent='Please provide an email address or phone number.';return;}if(!turnstileToken){status.textContent='Please complete the security check.';return;}submit.disabled=true;try{const res=await fetch('/api/public-leads',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({firstName:d.get('firstName'),lastName:d.get('lastName'),email:d.get('email'),phone:d.get('phone'),leadType:referral?'realtor_referral':'financing',referralRequested:referral,referralConsent:consent.checked,hasRealtor:hasRealtor.value,programInterest:d.get('programInterest'),message:d.get('message'),websitePath:'/investor-zone',turnstileToken})});const result=await res.json();if(!res.ok)throw new Error(result.error||'We could not submit your inquiry.');form.reset();turnstileToken='';status.textContent=referral?'Thank you. Your Realtor referral request has been received.':'Thank you. Your financing inquiry has been received.';if(window.turnstile)window.turnstile.reset();}catch(err){status.textContent=err.message||'Please try again or use our Contact page.';if(window.turnstile)window.turnstile.reset();turnstileToken='';}finally{submit.disabled=false;}});
</script>
<style>
:global(body){margin:0;background:#002447;color:#f7fbff;font-family:Arial,Helvetica,sans-serif}.page{max-width:1180px;margin:auto;padding:55px 26px 85px}.hero{padding:45px 0 65px;max-width:800px}.eyebrow{font-size:11px;letter-spacing:2px;font-weight:800;color:#18d0d0}.hero h1{font-size:clamp(40px,6vw,65px);line-height:1.04;letter-spacing:-2px;margin:18px 0;color:#fff}.hero h1 em{font-style:normal;color:#18d0d0}.hero p,.form-section>div>p{color:#cfdae4;font-size:18px;line-height:1.65;max-width:700px}.button,form button{display:inline-flex;gap:18px;align-items:center;border:0;border-radius:28px;background:#18d0d0;color:#002447;padding:14px 23px;font-weight:800;text-decoration:none;cursor:pointer}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.features article{padding:25px;background:#083456;border:1px solid #176083;border-top:3px solid #18d0d0}.features span{color:#18d0d0;font-weight:800}.features h2{font-size:21px;color:#fff}.features p{color:#c9d7e2;font-size:14px;line-height:1.65}.realtor{display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:center;margin:60px 0;padding:35px;background:#073354;border:1px solid #176083;border-radius:14px}.realtor h2,.form-section h2{font-size:clamp(28px,4vw,38px);line-height:1.1;color:#fff;margin:12px 0}.realtor p,.choice small{color:#cbd9e3;line-height:1.6}.choice{display:grid;gap:13px}.choice p{margin:0;color:#fff}.choice label{display:flex;gap:10px;align-items:center;color:#eef6fa}.choice input{accent-color:#18d0d0}.form-section{display:grid;grid-template-columns:.8fr 1.2fr;gap:45px;align-items:start;padding-top:25px}.form-section ul{color:#cbd9e3;padding-left:19px;line-height:2}.form-section form{padding:28px;background:#f7fbfc;color:#18324a;border-radius:12px;display:grid;gap:15px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.fields label{display:grid;gap:6px;font-size:13px;font-weight:700}.fields .wide{grid-column:1/-1}.fields input,.fields select,.fields textarea{width:100%;box-sizing:border-box;border:1px solid #c6d5df;border-radius:6px;padding:11px;font:inherit;color:#18324a;background:white}.consent-row{display:flex;gap:10px;align-items:flex-start;font-size:12px;line-height:1.5}.consent-row input{margin-top:3px;accent-color:#087f87}.turnstile{min-height:65px}.status{font-size:13px;color:#075e69;font-weight:700;margin:0}.form-section form>small{font-size:11px;color:#66798b;line-height:1.5}.form-section form button{justify-content:center}.form-section form button:disabled{opacity:.55;cursor:not-allowed}@media(max-width:760px){.features{grid-template-columns:1fr}.realtor,.form-section{grid-template-columns:1fr}.realtor{padding:24px}.fields{grid-template-columns:1fr}.fields .wide{grid-column:auto}.page{padding:35px 19px 60px}}
</style>