---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/investor-zone.css';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<!doctype html>
<html lang="en">
<head><BaseHead title="Investor Zone | Broker Pal" description="A workspace for real estate investors to organize property activity and connect with financing and transaction resources." /></head>
<body><Header />
<main class="page">
  <section class="hero"><div class="eyebrow">BROKER PAL INVESTOR ZONE</div><h1>Your portfolio. Your next move. <em>One connected place.</em></h1><p>Bring your investment activity into focus, find useful transaction resources, and connect with financing guidance when you're ready.</p><a class="button" href="#investor-inquiry">Talk financing with Broker Pal <span>→</span></a></section>
  <section class="features"><article><span>01</span><h2>Property overview</h2><p>Keep property details, acquisition notes, and important milestones organized in one investor workspace.</p></article><article><span>02</span><h2>Transaction resources</h2><p>Build a reliable circle of real estate professionals, from agents and title teams to attorneys and tax advisors.</p></article><article><span>03</span><h2>Financing conversations</h2><p>Explore DSCR rental, fix-and-flip, bridge, and commercial financing options based on your next project.</p></article></section>
  <section class="realtor"><div><div class="eyebrow">YOUR REAL ESTATE TEAM</div><h2>Already working with a Realtor?</h2><p>We want to respect the relationships you've already built—and help when you need a connection.</p></div><div class="choice"><p><b>Do you already have a Realtor?</b></p><label><input type="radio" name="realtorStatus" value="yes"> Yes, I have a Realtor</label><label><input type="radio" name="realtorStatus" value="no"> No, not currently</label><label><input type="radio" name="realtorStatus" value="need_referral"> I'd like a Realtor referral</label><small>If you request an introduction, we'll ask for your permission before sharing your contact information with an agent.</small></div></section>
  <section class="form-section" id="investor-inquiry"><div><div class="eyebrow">FINANCING INQUIRY</div><h2>Have a property or financing question?</h2><p>Tell us a little about your plans. This is an inquiry—not a loan application or credit authorization.</p><ul><li>DSCR rental property financing</li><li>Fix &amp; flip and bridge loans</li><li>Commercial and business-purpose financing</li></ul></div>
    <form id="investorLead" data-page="/investor-zone" data-lead-type="financing" data-sitekey={siteKey}>
      <div class="fields"><label>First name<input name="firstName" autocomplete="given-name" required maxlength="80"></label><label>Last name<input name="lastName" autocomplete="family-name" required maxlength="80"></label><label>Email<input type="email" name="email" autocomplete="email" maxlength="254"></label><label>Phone<input type="tel" name="phone" autocomplete="tel" maxlength="40"></label><label class="wide">Financing interest<select name="programInterest"><option value="DSCR rental">DSCR rental</option><option value="Fix and flip">Fix &amp; flip</option><option value="Bridge loan">Bridge loan</option><option value="Commercial / business purpose">Commercial / business purpose</option><option value="Not sure yet">Not sure yet</option></select></label><label class="wide">What are you working on?<textarea name="message" rows="3" maxlength="1000"></textarea></label></div>
      <input type="hidden" name="hasRealtor" id="hasRealtor" value=""><div class="consent-row"><input type="checkbox" id="referralConsent" name="referralConsent"><label for="referralConsent">I authorize Broker Pal to contact me about a Realtor introduction if I selected that I would like a referral. My information will not be shared with an agent unless I request and authorize an introduction.</label></div>
      <label class="consent-row"><input type="checkbox" name="emailMarketingConsent"><span>I’d also like occasional email updates about commercial real estate financing and investor resources. I can unsubscribe at any time.</span></label><div class="turnstile" data-sitekey={siteKey}></div><button type="submit">Send my inquiry <span>→</span></button><p class="status" role="status" aria-live="polite"></p><small>By submitting, you agree Broker Pal may contact you about this inquiry. No automated marketing calls or texts are authorized by this form.</small>
    </form>
  </section>
</main><Footer />
<script>
const form=document.querySelector('#investorLead');const siteKey=form?.dataset.sitekey||'';
const status=form?.querySelector('.status');
const statusChoice=document.querySelectorAll('input[name="realtorStatus"]');
const hasRealtor=document.querySelector('#hasRealtor');
const consent=document.querySelector('#referralConsent');
const submit=form?.querySelector('button[type="submit"]');
let turnstileToken='';
function loadTurnstile(){
 if(!siteKey){status.textContent='Secure inquiry submission is being configured. Please use the Contact page in the meantime.';submit.disabled=true;return;}
 const s=document.createElement('script');s.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';s.async=true;s.defer=true;s.onload=()=>{if(window.turnstile){window.turnstile.render(form.querySelector('.turnstile'),{sitekey:siteKey,callback:t=>turnstileToken=t,'expired-callback':()=>turnstileToken=''});}};document.head.appendChild(s);
}
statusChoice.forEach(el=>el.addEventListener('change',()=>{hasRealtor.value=document.querySelector('input[name="realtorStatus"]:checked')?.value||'';consent.required=hasRealtor.value==='need_referral';}));
loadTurnstile();
form?.addEventListener('submit',async e=>{e.preventDefault();status.textContent='';const d=new FormData(form);if(!hasRealtor.value){status.textContent='Please tell us whether you already have a Realtor or would like a referral.';return;}const referral=hasRealtor.value==='need_referral';if(referral&&!consent.checked){status.textContent='Please authorize an introduction before requesting a Realtor referral.';return;}if(!d.get('email')&&!d.get('phone')){status.textContent='Please provide an email address or phone number.';return;}if(!turnstileToken){status.textContent='Please complete the security check.';return;}submit.disabled=true;try{const res=await fetch('/api/public-leads',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({firstName:d.get('firstName'),lastName:d.get('lastName'),email:d.get('email'),phone:d.get('phone'),leadType:referral?'realtor_referral':'financing',referralRequested:referral,referralConsent:consent.checked,hasRealtor:hasRealtor.value,programInterest:d.get('programInterest'),message:d.get('message'),websitePath:'/investor-zone',turnstileToken,emailMarketingConsent:d.get('emailMarketingConsent')==='on'})});const result=await res.json();if(!res.ok)throw new Error(result.error||'We could not submit your inquiry.');form.reset();turnstileToken='';status.textContent=referral?'Thank you. Your Realtor referral request has been received.':'Thank you. Your financing inquiry has been received.';if(window.turnstile)window.turnstile.reset();}catch(err){status.textContent=err.message||'Please try again or use our Contact page.';if(window.turnstile)window.turnstile.reset();turnstileToken='';}finally{submit.disabled=false;}});
</script>
</body>
</html>
