<script>
const root = document.querySelector('#investor-hub');
if (root) {
  const $ = (id) => document.getElementById(id);
  const defaults = { company: 'My Investment Co.', display: '', theme: 'dark', accent: '#22c7c5', density: 'comfortable', start: 'overview' };
  let settings = { ...defaults };
  let logoUrl = '';
  const renderBrandAvatar = () => {
    const safePattern = new RegExp('^data:image/(?:png|jpeg|webp);base64,[A-Za-z0-9+/]+=*' + String.fromCharCode(36));
    if (typeof logoUrl === 'string' && logoUrl.length <= 2800000 && safePattern.test(logoUrl)) {
      const image = document.createElement('img');
      image.alt = 'Company logo preview';
      image.src = logoUrl;
      $('brand-avatar').replaceChildren(image);
    } else {
      $('brand-avatar').textContent = (settings.company || 'BP').split(' ').filter(Boolean).slice(0,2).map(x=>x[0]||'').join('').toUpperCase();
    }
  };
  const apply = () => {
    root.classList.toggle('compact', settings.density === 'compact');
    root.classList.toggle('light', settings.theme === 'light');
    root.style.setProperty('--accent', settings.accent);
    $('brand-name').textContent = settings.company || 'My Investment Co.';
    $('welcome-title').textContent = settings.display ? 'Welcome, ' + settings.display : 'Welcome to your property hub';
    $('company-name').value = settings.company;
    $('display-name').value = settings.display;
    $('density').value = settings.density;
    $('start-view').value = settings.start;
    document.querySelectorAll('[data-theme]').forEach(b => b.classList.toggle('active', b.dataset.theme === settings.theme));
    document.querySelectorAll('[data-accent]').forEach(b => b.classList.toggle('active', b.dataset.accent === settings.accent));
    renderBrandAvatar();
  };
  try {
    const saved = localStorage.getItem('brokerpal-investor-design');
    if (saved) settings = { ...defaults, ...JSON.parse(saved) };
  } catch {}
  apply();
  $('company-name').addEventListener('input', e => { settings.company = e.target.value.slice(0,48); $('brand-name').textContent = settings.company || 'My Investment Co.'; renderBrandAvatar(); });
  $('display-name').addEventListener('input', e => { settings.display = e.target.value.slice(0,40); $('welcome-title').textContent = settings.display ? 'Welcome, ' + settings.display : 'Welcome to your property hub'; });
  document.querySelectorAll('[data-theme]').forEach(b => b.addEventListener('click', () => { settings.theme = b.dataset.theme === 'system' ? 'dark' : b.dataset.theme; apply(); }));
  document.querySelectorAll('[data-accent]').forEach(b => b.addEventListener('click', () => { settings.accent = b.dataset.accent; apply(); }));
  $('density').addEventListener('change', e => { settings.density = e.target.value; apply(); });
  $('start-view').addEventListener('change', e => { settings.start = e.target.value; });
  $('brand-logo').addEventListener('change', e => {
    const file = e.target.files?.[0];
    if (!file) return;
    if (!/^image\/(png|jpeg|webp)$/.test(file.type) || file.size > 2 * 1024 * 1024) { $('save-status').textContent = 'Choose a PNG, JPG or WebP image under 2 MB.'; return; }
    const reader = new FileReader();
    reader.onload = () => { logoUrl = String(reader.result); renderBrandAvatar(); $('save-status').textContent = 'Logo preview loaded for this session; it is not uploaded.'; };
    reader.readAsDataURL(file);
  });
  $('save-design').addEventListener('click', () => {
    try { localStorage.setItem('brokerpal-investor-design', JSON.stringify(settings)); $('save-status').textContent = 'Design saved on this device only.'; }
    catch { $('save-status').textContent = 'Could not save in this browser. Your current preview remains active.'; }
    const target = document.getElementById(settings.start);
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  $('reset-design').addEventListener('click', () => { settings = { ...defaults }; logoUrl = ''; $('brand-logo').value = ''; try { localStorage.removeItem('brokerpal-investor-design'); } catch {} apply(); $('save-status').textContent = 'Preview reset.'; });

  const cpaGrants = [];
  const renderCpaGrants = () => {
    const container = $('cpa-grants');
    container.replaceChildren();
    const title = document.createElement('b');
    title.textContent = 'Temporary access invitations';
    container.append(title);
    if (!cpaGrants.length) {
      const empty = document.createElement('p');
      empty.textContent = 'No invitations in this preview.';
      container.append(empty);
      return;
    }
    cpaGrants.forEach((grant, index) => {
      const row = document.createElement('div');
      row.className = 'cpa-grant-row';
      const details = document.createElement('span');
      details.textContent = grant.name + ' · ' + grant.email + ' · ' + grant.duration + ' · ' + (grant.revoked ? 'Revoked' : 'Pending secure setup');
      const revoke = document.createElement('button');
      revoke.type = 'button';
      revoke.textContent = grant.revoked ? 'Revoked' : 'Revoke preview';
      revoke.disabled = grant.revoked;
      revoke.addEventListener('click', () => {
        grant.revoked = true;
        renderCpaGrants();
      });
      row.append(details, revoke);
      container.append(row);
    });
  };
  const cpaButton = $('cpa-invite');
  if (cpaButton) cpaButton.addEventListener('click', () => {
    const name = $('cpa-name').value.trim();
    const email = $('cpa-email').value.trim();
    const status = $('cpa-status');
    const preview = $('cpa-invite-preview');
    const permissions = [
      ['cpa-properties', 'Property summaries'],
      ['cpa-financials', 'Income and expense summaries'],
      ['cpa-bills', 'Bills, tax and insurance records'],
      ['cpa-documents', 'Selected supporting documents']
    ].filter(([id]) => $(id).checked).map(([, label]) => label);
    if (!name || !email || !email.includes('@') || !email.includes('.')) {
      status.textContent = 'Enter the CPA name and a valid email address to preview the invitation.';
      preview.hidden = true;
      return;
    }
    if (!permissions.length) {
      status.textContent = 'Select at least one information category.';
      preview.hidden = true;
      return;
    }
    const grant = { name, email, duration: $('cpa-duration').value, permissions, revoked: false };
    cpaGrants.push(grant);
    preview.hidden = false;
    preview.replaceChildren();
    const heading = document.createElement('b');
    heading.textContent = 'Invitation prepared — demonstration only';
    const detail = document.createElement('p');
    detail.textContent = 'Proposed recipient: ' + name + ' (' + email + '). Access: ' + permissions.join(', ') + '. Duration: ' + grant.duration + '. Permission level: ' + $('cpa-type').value + '.';
    const warning = document.createElement('p');
    warning.textContent = 'This creates only an in-memory demonstration entry. No email, login, access link, token or data permission is issued.';
    preview.append(heading, detail, warning);
    status.textContent = 'Demonstration invitation added below. You can test the revoke control.';
    renderCpaGrants();
  });
  const picker = $('document-picker'), zone = $('drop-zone'), list = $('file-preview');
  const showFiles = files => {
    const safe = Array.from(files || []).filter(f => /\.(pdf|jpe?g|png)$/i.test(f.name)).slice(0,8);
    list.textContent = '';
    if (!safe.length) { list.textContent = 'No supported files selected.'; return; }
    safe.forEach(file => { const chip = document.createElement('span'); chip.className = 'file-chip'; chip.textContent = file.name + ' · ' + Math.max(1, Math.round(file.size/1024)) + ' KB'; list.append(chip); });
    const note = document.createElement('div'); note.className = 'section-foot'; note.textContent = 'Local file selection preview only. No file contents were read, uploaded, processed or saved.'; list.append(note);
  };
  picker.addEventListener('change', e => showFiles(e.target.files));
  ['dragenter','dragover'].forEach(type => zone.addEventListener(type, e => { e.preventDefault(); zone.classList.add('dragging'); }));
  ['dragleave','drop'].forEach(type => zone.addEventListener(type, e => { e.preventDefault(); zone.classList.remove('dragging'); }));
  zone.addEventListener('drop', e => showFiles(e.dataTransfer?.files));
}
</script>
