---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/realtor-profile.css';
import { env } from 'cloudflare:workers';

export const prerender = false;
const slug = String(Astro.params.slug || '').toLowerCase();
const leadsEndpoint = String(env.LOS_PUBLIC_LEADS_URL || '').trim();
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
let profile: any = null;
let unavailable = false;
if (leadsEndpoint && /^[a-z0-9](?:[a-z0-9-]{0,58}[a-z0-9])?$/.test(slug)) {
  try {
    const base = new URL(leadsEndpoint);
    const lookup = new URL('/api/public-realtors', base.origin);
    lookup.searchParams.set('slug', slug);
    const response = await fetch(lookup, { headers: { accept: 'application/json' } });
    const data = await response.json();
    if (response.ok && data?.ok && data.profile) profile = data.profile;
    else unavailable = true;
  } catch { unavailable = true; }
} else { unavailable = true; }
if (!profile) Astro.response.status = 404;
const title = profile ? profile.display_name + ' | Broker Pal Realtor' : 'Realtor page unavailable | Broker Pal';
const description = profile ? (profile.bio || profile.display_name + ' — Realtor profile, featured properties, and client resources.').slice(0, 300) : 'This Realtor page is not currently available.';
const primary = profile?.primary_color || '#002447';
const accent = profile?.accent_color || '#18d0d0';
---
<!doctype html>
<html lang="en">
<head><BaseHead title={title} description={description} image={profile?.headshot_url || undefined} /></head>
<body>
<Header />
{profile ? (
<main class="agent-page" style={'--agent-primary:'+primary+';--agent-accent:'+accent}>
  <section class="agent-hero">
    <div class="agent-intro">
      <div class="eyebrow">BROKER PAL REALTOR NETWORK</div>
      {profile.logo_url && <img class="agent-logo" src={profile.logo_url} alt={profile.display_name+" logo"} loading="eager" />}
      <h1>{profile.display_name}</h1>
      {profile.professional_title && <p class="professional-title">{profile.professional_title}</p>}
      {profile.brokerage_name && <p class="brokerage">{profile.brokerage_name}</p>}
      <p class="bio">{profile.bio || 'Local guidance, thoughtful service, and a clear path to your next real estate move.'}</p>
      {profile.service_areas?.length > 0 && <div class="areas"><b>Serving</b> {profile.service_areas.join(' · ')}</div>}
      <div class="hero-actions">
        {profile.phone && <a class="agent-button" href={'tel:'+profile.phone}>Call {profile.phone}</a>}
        {profile.public_email && <a class="agent-outline" href={'mailto:'+profile.public_email}>Email Realtor</a>}
      </div>
    </div>
    {profile.headshot_url && <img class="headshot" src={profile.headshot_url} alt={'Professional portrait of '+profile.display_name} loading="eager" />}
    {!profile.headshot_url && <div class="headshot-placeholder">{profile.display_name.split(' ').map((part:string)=>part[0]).join('').slice(0,2).toUpperCase()}</div>}
  </section>
  {profile.specialties?.length > 0 && <section class="specialties"><div class="eyebrow">AREAS OF FOCUS</div><div class="chips">{profile.specialties.map((item:string)=><span>{item}</span>)}</div></section>}
  {profile.featured_properties?.length > 0 && <section class="listings"><div class="section-heading"><div class="eyebrow">FEATURED PROPERTIES</div><h2>Properties to explore</h2></div><div class="listing-grid">{profile.featured_properties.map((item:any)=><article class="listing-card">{item.image_url && <img src={item.image_url} alt={item.title || item.address || 'Featured property'} loading="lazy" />}<div class="listing-copy">{item.title && <h3>{item.title}</h3>}{item.price && <b class="price">{item.price}</b>}{(item.address || item.city) && <p>{[item.address,item.city,item.state].filter(Boolean).join(', ')}</p>}{item.description && <p>{item.description}</p>}{item.listing_url && <a href={item.listing_url} target="_blank" rel="noopener noreferrer">View property details →</a>}</div></article>)}</div></section>}
  <section class="financing">
    <div><div class="eyebrow">FINANCING CONNECTION</div><h2>Need financing for your next move?</h2><p>Broker Pal can discuss DSCR rental, fix-and-flip, bridge, commercial, and business-purpose financing. Your inquiry is attributed to {profile.display_name} so the referring relationship is clear.</p><p class="privacy-note">Your contact information is sent to Broker Pal for this financing inquiry. It is not automatically shared with other agents or service providers.</p></div>
    <form id="agentLead">
      <h3>Request a financing conversation</h3>
      <div class="fields"><label>First name<input name="firstName" required maxlength="80" autocomplete="given-name" /></label><label>Last name<input name="lastName" required maxlength="80" autocomplete="family-name" /></label><label>Email<input type="email" name="email" maxlength="254" autocomplete="email" /></label><label>Phone<input type="tel" name="phone" maxlength="40" autocomplete="tel" /></label><label class="wide">Financing interest<select name="programInterest"><option>DSCR rental</option><option>Fix and flip</option><option>Bridge loan</option><option>Commercial / business purpose</option><option>Not sure yet</option></select></label><label class="wide">What are you working on?<textarea name="message" rows="3" maxlength="1000"></textarea></label></div>
      <label class="consent-row"><input type="checkbox" name="emailMarketingConsent"><span>I’d also like occasional email updates about commercial real estate financing and investor resources. I can unsubscribe at any time.</span></label><div class="turnstile"></div><button type="submit" disabled={!siteKey}>Send financing inquiry →</button><p class="status" role="status" aria-live="polite"></p><small>By submitting, you agree Broker Pal may contact you about this inquiry. This form does not authorize automated marketing calls or texts.</small>
    </form>
  </section>
  <footer class="agent-footer">
    <div><b>{profile.display_name}</b>{profile.license_number && <span> · License {profile.license_number}</span>}</div>
    <div class="socials">{profile.website_url && <a href={profile.website_url} target="_blank" rel="noopener noreferrer">Website</a>}{profile.instagram_url && <a href={profile.instagram_url} target="_blank" rel="noopener noreferrer">Instagram</a>}{profile.facebook_url && <a href={profile.facebook_url} target="_blank" rel="noopener noreferrer">Facebook</a>}{profile.linkedin_url && <a href={profile.linkedin_url} target="_blank" rel="noopener noreferrer">LinkedIn</a>}</div>
    <small>Powered by Broker Pal · Financing inquiries are handled separately from real estate representation.</small>
  </footer>
</main>
) : (
<main class="unavailable"><div class="eyebrow">BROKER PAL REALTOR NETWORK</div><h1>This Realtor page isn't available yet.</h1><p>The page may be unpublished or its profile has not been configured. You can still reach Broker Pal for help with a real estate financing question.</p><a href="/contact">Contact Broker Pal →</a></main>
)}
<Footer />
<script>
const form=document.querySelector('#agentLead');const status=form?.querySelector('.status');const submit=form?.querySelector('button[type="submit"]');const siteKey=form?.dataset.sitekey||'';const agentName=form?.dataset.agentName||'';const agentEmail=form?.dataset.agentEmail||'';const agentPage=form?.dataset.agentPage||'';let turnstileToken='';
if(form&&siteKey){const script=document.createElement('script');script.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';script.async=true;script.defer=true;script.onload=()=>{if(window.turnstile)window.turnstile.render(form.querySelector('.turnstile'),{sitekey:siteKey,callback:t=>{turnstileToken=t;submit.disabled=false;},'expired-callback':()=>{turnstileToken='';submit.disabled=true;}});};document.head.appendChild(script);if(submit)submit.disabled=true;}
form?.addEventListener('submit',async e=>{e.preventDefault();status.textContent='';const d=new FormData(form);if(!d.get('email')&&!d.get('phone')){status.textContent='Please provide an email address or phone number.';return;}if(!turnstileToken){status.textContent='Please complete the security check.';return;}submit.disabled=true;try{const response=await fetch('/api/public-leads',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({firstName:d.get('firstName'),lastName:d.get('lastName'),email:d.get('email'),phone:d.get('phone'),leadType:'financing',programInterest:d.get('programInterest'),message:d.get('message'),websitePath:agentPage,agentName,agentEmail,agentPage,turnstileToken,emailMarketingConsent:d.get('emailMarketingConsent')==='on'})});const result=await response.json();if(!response.ok)throw new Error(result.error||'We could not submit your inquiry.');form.reset();turnstileToken='';status.textContent='Thank you. Your financing inquiry has been received.';if(window.turnstile){window.turnstile.reset();}submit.disabled=true;}catch(error){status.textContent=error.message||'Please try again.';turnstileToken='';if(window.turnstile)window.turnstile.reset();submit.disabled=true;}});
</script>

</body>
</html>
