---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<!doctype html>
<html lang="en">
<head><BaseHead title="Realtor Studio | Broker Pal" description="A professional web presence for Realtors, with listing inquiries and an optional investor financing connection." /></head>
<body><Header />
<main class="page">
  <section class="hero"><div class="eyebrow">BROKER PAL REALTOR STUDIO</div><h1>Your business deserves a home <em>that works as hard as you do.</em></h1><p>A professional, agent-branded web presence designed to showcase your business, highlight properties, and turn visitors into real conversations.</p><a class="button" href="#agent-financing">See the financing inquiry funnel <span>→</span></a></section>
  <section class="preview"><div class="mock"><div class="mock-top">YOUR NAME / REAL ESTATE PROFESSIONAL</div><div class="mock-hero"><span>LOCAL KNOWLEDGE. PERSONAL SERVICE.</span><h2>Your next move<br/>starts here.</h2><p>Featured listings · Service areas · About your business</p></div><div class="mock-cards"><b>Featured property</b><b>About the agent</b><b>Recent activity</b></div></div><div class="preview-copy"><div class="eyebrow">AGENT-OWNED PUBLIC PAGE</div><h2>Your brand leads. Broker Pal supports.</h2><p>Each Realtor page is intended to carry the agent's identity, service areas, listings, contact details, and lead attribution. Your visitors see a page built around your business—not a generic directory profile.</p><ul><li>Agent bio, branding, contact and service areas</li><li>Listing pages and property inquiry forms</li><li>Lead source recorded with the agent's page</li><li>Optional financing inquiry routed to Broker Pal</li></ul></div></section>
  <section class="financing"><div><div class="eyebrow">OPTIONAL FINANCING CONNECTION</div><h2>When a buyer or investor needs financing, make the next step easy.</h2><p>Your public page can include a clear financing inquiry for DSCR, fix-and-flip, bridge, commercial, and business-purpose loans. The inquiry records your agent-page attribution so Broker Pal can identify the referring Realtor.</p><p class="note">A financing inquiry does not authorize sharing the person's information with other agents or service providers.</p></div>
  <form id="agentLead" data-page="/realtor-studio">
    <h3>Ask Broker Pal about financing</h3><p class="form-intro">This quick inquiry is for visitors to your Realtor page who want to discuss financing.</p>
    <div class="fields"><label>First name<input name="firstName" required maxlength="80" autocomplete="given-name"></label><label>Last name<input name="lastName" required maxlength="80" autocomplete="family-name"></label><label>Email<input type="email" name="email" maxlength="254" autocomplete="email"></label><label>Phone<input type="tel" name="phone" maxlength="40" autocomplete="tel"></label><label class="wide">Financing interest<select name="programInterest"><option>DSCR rental</option><option>Fix and flip</option><option>Bridge loan</option><option>Commercial / business purpose</option><option>Not sure yet</option></select></label><label class="wide">How can we help?<textarea name="message" rows="3" maxlength="1000"></textarea></label></div>
    <label class="consent-row"><input type="checkbox" name="emailMarketingConsent"><span>I’d also like occasional email updates about commercial real estate financing and investor resources. I can unsubscribe at any time.</span></label><div class="turnstile" data-sitekey={siteKey}></div><button type="submit">Send financing inquiry <span>→</span></button><p class="status" role="status" aria-live="polite"></p><small>By submitting, you agree Broker Pal may contact you about this financing inquiry. No automated marketing calls or texts are authorized by this form.</small>
  </form></section>
  <section class="cta"><h2>Are you a Realtor interested in your own page?</h2><p>Tell us about your business and the features you'd like to offer your clients.</p><a href="/contact?subject=Realtor%20Studio%20interest">Contact Broker Pal →</a></section>
</main><Footer />
<script define:vars={{siteKey}}>
const form=document.querySelector('#agentLead');const status=form?.querySelector('.status');const submit=form?.querySelector('button[type="submit"]');let turnstileToken='';const pageParams=new URLSearchParams(location.search);const agentName=(pageParams.get('agentName')||'').slice(0,120);const agentEmail=(pageParams.get('agentEmail')||'').slice(0,254);const agentPage=(pageParams.get('agentPage')||location.pathname).slice(0,240);
if(!siteKey){status.textContent='Secure inquiry submission is being configured. Please use the Contact page in the meantime.';submit.disabled=true;}else{const s=document.createElement('script');s.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';s.async=true;s.defer=true;s.onload=()=>{if(window.turnstile)window.turnstile.render(form.querySelector('.turnstile'),{sitekey:siteKey,callback:t=>turnstileToken=t,'expired-callback':()=>turnstileToken=''});};document.head.appendChild(s);}
form?.addEventListener('submit',async e=>{e.preventDefault();status.textContent='';const d=new FormData(form);if(!d.get('email')&&!d.get('phone')){status.textContent='Please provide an email address or phone number.';return;}if(!turnstileToken){status.textContent='Please complete the security check.';return;}submit.disabled=true;try{const res=await fetch('/api/public-leads',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({firstName:d.get('firstName'),lastName:d.get('lastName'),email:d.get('email'),phone:d.get('phone'),leadType:'financing',programInterest:d.get('programInterest'),message:d.get('message'),websitePath:'/realtor-studio',agentName,agentEmail,agentPage,turnstileToken,emailMarketingConsent:d.get('emailMarketingConsent')==='on'})});const result=await res.json();if(!res.ok)throw new Error(result.error||'We could not submit your inquiry.');form.reset();turnstileToken='';status.textContent='Thank you. Your financing inquiry has been received.';if(window.turnstile)window.turnstile.reset();}catch(err){status.textContent=err.message||'Please try again or use our Contact page.';if(window.turnstile)window.turnstile.reset();turnstileToken='';}finally{submit.disabled=false;}});
</script>
<style is:global>
body{margin:0;background:#002447;color:#f7fbff;font-family:Arial,Helvetica,sans-serif}
</style>
<style>.page{max-width:1180px;margin:auto;padding:55px 26px 85px}.eyebrow{font-size:11px;letter-spacing:2px;font-weight:800;color:#18d0d0}.hero{padding:45px 0 65px;max-width:850px}.hero h1{font-size:clamp(40px,6vw,65px);line-height:1.04;letter-spacing:-2px;margin:18px 0;color:#fff}.hero h1 em{font-style:normal;color:#18d0d0}.hero p{color:#cfdae4;font-size:18px;line-height:1.65}.button,form button{display:inline-flex;gap:18px;align-items:center;border:0;border-radius:28px;background:#18d0d0;color:#002447;padding:14px 23px;font-weight:800;text-decoration:none;cursor:pointer}.preview{display:grid;grid-template-columns:1.05fr .95fr;gap:45px;align-items:center;margin:0 0 70px}.mock{padding:13px;background:#f6fafc;border-radius:12px;box-shadow:0 20px 55px #00172a80;color:#18324a}.mock-top{font-size:10px;font-weight:800;letter-spacing:1px;padding:12px}.mock-hero{min-height:255px;padding:28px;background:linear-gradient(115deg,#092d4d,#126477);color:white}.mock-hero span{font-size:10px;letter-spacing:1.5px;color:#7fe8df}.mock-hero h2{font-size:38px;line-height:1.05;margin:16px 0}.mock-hero p{font-size:12px;color:#d8e9ee}.mock-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding-top:10px}.mock-cards b{background:#e7eff3;padding:16px 9px;font-size:11px}.preview-copy h2,.financing h2,.cta h2{font-size:clamp(29px,4vw,39px);line-height:1.1;color:white;margin:12px 0}.preview-copy p,.financing p,.cta p{color:#cad8e2;line-height:1.7}.preview-copy ul{padding-left:19px;color:#d6e3e9;line-height:2}.financing{display:grid;grid-template-columns:.9fr 1.1fr;gap:45px;align-items:start;padding:35px;background:#073354;border:1px solid #176083;border-radius:14px}.financing .note{font-size:12px;color:#9eb8c6}.financing form{background:#f7fbfc;color:#18324a;padding:26px;border-radius:10px;display:grid;gap:14px}.financing form h3{font-size:22px;margin:0;color:#17324b}.form-intro{font-size:13px!important;color:#66798b!important;margin:0}.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.fields label{display:grid;gap:6px;font-size:13px;font-weight:700}.fields .wide{grid-column:1/-1}.fields input,.fields select,.fields textarea{width:100%;box-sizing:border-box;border:1px solid #c6d5df;border-radius:6px;padding:11px;font:inherit;color:#18324a;background:white}.turnstile{min-height:65px}.financing form button{justify-content:center}.financing form button:disabled{opacity:.55;cursor:not-allowed}.status{font-size:13px;color:#075e69;font-weight:700;margin:0}.financing form small{font-size:11px;color:#66798b;line-height:1.5}.cta{margin-top:60px;padding:36px;background:#0a3855;border-left:4px solid #18d0d0}.cta h2{margin-top:0}.cta a{color:#18d0d0;font-weight:800;text-decoration:none}@media(max-width:760px){.preview,.financing{grid-template-columns:1fr}.page{padding:35px 19px 60px}.fields{grid-template-columns:1fr}.fields .wide{grid-column:auto}.financing{padding:20px}.mock-hero{min-height:215px}}
</style>