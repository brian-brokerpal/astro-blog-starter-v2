---
import Layout from '../layouts/BlogPost.astro';
---
<Layout title="Realtor Studio | broker pal" description="Create a branded real estate presence with the broker pal Design Assistant.">
<main class="studio" id="realtor-studio">
  <section class="intro">
    <div>
      <p class="eyebrow">BROKER PAL · REALTOR STUDIO</p>
      <h1>Your business.<br/><em>Your look.</em></h1>
      <p class="lead">Build a polished agent page without becoming a designer. Add your logo, tell us the impression you want to make, and explore three coordinated design directions.</p>
    </div>
    <div class="intro-mark"><span>✦</span><b>DESIGN ASSISTANT</b><small>Simple choices. A more personal brand.</small></div>
  </section>

  <section class="studio-shell">
    <div class="setup-panel">
      <div class="panel-heading"><span class="step">01</span><div><h2>Start with your brand</h2><p>A few details are all we need to get started.</p></div></div>
      <label class="field-label" for="company-name">Company or agent name</label>
      <input id="company-name" class="text-input" maxlength="60" value="Oak & Stone Realty" placeholder="Your business name"/>
      <label class="field-label" for="tagline">Short introduction <span>Optional</span></label>
      <textarea id="tagline" class="text-input" rows="2" maxlength="150" placeholder="Helping you make your next move.">Local guidance. Thoughtful service. Real estate with a personal touch.</textarea>
      <label class="field-label" for="brand-logo">Upload your logo</label>
      <label class="upload-control" for="brand-logo"><span class="upload-icon">＋</span><span><b id="upload-title">Choose a logo</b><small>PNG, JPG or WebP · Up to 2 MB · stays on this device</small></span><input id="brand-logo" type="file" accept="image/png,image/jpeg,image/webp"/></label>
      <div class="field-label">What should your brand feel like?</div>
      <div class="vibe-grid" role="group" aria-label="Brand style">
        <button type="button" class="vibe active" data-vibe="modern"><b>Modern</b><small>Clean and confident</small></button>
        <button type="button" class="vibe" data-vibe="luxury"><b>Luxury</b><small>Refined and elevated</small></button>
        <button type="button" class="vibe" data-vibe="warm"><b>Warm</b><small>Welcoming and personal</small></button>
        <button type="button" class="vibe" data-vibe="bold"><b>Bold</b><small>Distinct and energetic</small></button>
      </div>
      <button type="button" class="generate" id="generate"><span>✦</span> Create my three designs</button>
      <p class="privacy">Your logo is analyzed locally in this browser for this preview. It is not uploaded to a design service or saved to an account.</p>
    </div>

    <div class="design-panel">
      <div class="panel-heading"><span class="step">02</span><div><h2>Choose a direction</h2><p>Three coordinated looks, prepared around your brand.</p></div></div>
      <div class="concepts" id="concepts">
        <article class="concept selected" data-concept="modern">
          <div class="concept-art art-modern"><span class="mock-brand">OAK & STONE</span><div class="mock-headline">A place<br/>to belong.</div><div class="mock-lines"></div><div class="mock-photo photo-one"></div><div class="mock-button"></div></div>
          <div class="concept-info"><div><b>Modern & Professional</b><small>Clean layouts · Confident typography</small></div><button type="button" class="choose" data-choose="modern">Use this look</button></div>
        </article>
        <article class="concept" data-concept="luxury">
          <div class="concept-art art-luxury"><span class="mock-brand">OAK & STONE</span><div class="mock-headline">Find your<br/><i>forever.</i></div><div class="mock-lines"></div><div class="mock-photo photo-two"></div><div class="mock-button"></div></div>
          <div class="concept-info"><div><b>Luxury & Refined</b><small>Editorial feel · Elegant details</small></div><button type="button" class="choose" data-choose="luxury">Use this look</button></div>
        </article>
        <article class="concept" data-concept="warm">
          <div class="concept-art art-warm"><span class="mock-brand">OAK & STONE</span><div class="mock-headline">Your next<br/>chapter starts here.</div><div class="mock-lines"></div><div class="mock-photo photo-three"></div><div class="mock-button"></div></div>
          <div class="concept-info"><div><b>Warm & Welcoming</b><small>Natural colors · Friendly layouts</small></div><button type="button" class="choose" data-choose="warm">Use this look</button></div>
        </article>
      </div>
      <div class="selection-note" id="selection-note" role="status">Modern & Professional is selected. Your preview is ready to personalize.</div>
    </div>
  </section>

  <section class="preview-section">
    <div class="preview-heading"><div><p class="eyebrow">03 · YOUR PUBLIC PAGE</p><h2>See what visitors could see</h2><p>This is a visual preview of the agent page—not a published website or live listing.</p></div><span class="preview-label">LIVE DESIGN PREVIEW</span></div>
    <div class="public-preview" id="public-preview" data-style="modern">
      <header class="preview-nav"><div class="preview-brand"><span class="preview-logo" id="preview-logo">O</span><b id="preview-company">OAK & STONE REALTY</b></div><nav><span>Home</span><span>Properties</span><span>About</span><span>Contact</span></nav><button type="button">Let's talk</button></header>
      <div class="public-hero">
        <div class="public-copy"><span class="public-kicker">A MORE PERSONAL REAL ESTATE EXPERIENCE</span><h3 id="preview-headline">A place<br/><i>to belong.</i></h3><p id="preview-tagline">Local guidance. Thoughtful service. Real estate with a personal touch.</p><button type="button">Explore properties <span>↗</span></button></div>
        <div class="public-image"><div class="image-caption">YOUR NEXT CHAPTER</div></div>
      </div>
      <div class="preview-bottom"><div><small>FEATURED PROPERTIES</small><b>A thoughtful approach to finding your place.</b></div><div class="sample-listings"><span>FEATURED HOME</span><span>NEW LISTING</span><span>EXPLORE THE AREA</span></div></div>
    </div>
    <div class="preview-actions"><button type="button" class="save" id="save-design">Save design on this device</button><button type="button" class="reset" id="reset-design">Start over</button><span id="save-status" role="status">Preview only · Not published</span></div>
  </section>
  <section class="next-steps"><div><span class="step">NEXT</span><h2>From a design to your own page</h2><p>The next connected release will let an authenticated agent save their brand, add real listings, publish a page address, and receive inquiries directly in their CRM.</p></div><div class="next-list"><span>✓ Brand and layout concepts</span><span>◷ Save to an agent account</span><span>◷ Publish a shareable agent page</span><span>◷ Connect listing inquiries to CRM</span></div></section>
  <p class="disclaimer">Design Assistant preview: logo analysis and design recommendations run locally in your browser using built-in styles. No external AI service is connected in this prototype. No account, public page, listing, lead capture, or secure storage is activated here.</p>
</main>
</Layout>

<style>
.studio{--ink:#102b40;--muted:#62798a;--line:#dce6e9;--brand:#1a9d99;--paper:#f5f8f8;color:var(--ink);background:#f5f8f8;padding:0 0 55px;font-family:Arial,Helvetica,sans-serif}
.studio *{box-sizing:border-box}.intro{background:#062943;color:#f4f8fa;padding:55px max(5vw,22px);display:flex;align-items:center;justify-content:space-between;gap:35px}.eyebrow{font-size:10px;letter-spacing:2px;font-weight:900;color:#20b8b1;margin:0 0 13px}.intro h1{font-size:clamp(42px,6vw,68px);line-height:.98;letter-spacing:-2.8px;margin:0 0 17px;color:#fff}.intro h1 em{font-style:normal;color:#60d2c9}.lead{max-width:610px;color:#c4d5de;font-size:15px;line-height:1.7;margin:0}.intro-mark{border:1px solid #3d6478;border-radius:12px;padding:20px 24px;min-width:210px;display:grid;gap:6px;background:#0c3550}.intro-mark span{font-size:28px;color:#5dd3c8}.intro-mark b{font-size:10px;letter-spacing:1.5px;color:#fff}.intro-mark small{font-size:10px;color:#a9c0cc}.studio-shell{max-width:1240px;margin:28px auto;padding:0 22px;display:grid;grid-template-columns:minmax(260px,.78fr) minmax(0,1.45fr);gap:18px}.setup-panel,.design-panel{background:#fff;border:1px solid var(--line);border-radius:13px;padding:23px;box-shadow:0 8px 28px #153b4b0b;min-width:0}.panel-heading{display:flex;align-items:flex-start;gap:12px;margin-bottom:22px}.step{width:29px;height:29px;border-radius:9px;background:#e2f5f2;color:#138b85;display:grid;place-items:center;font-size:10px;font-weight:900;flex:0 0 29px}.panel-heading h2{font-size:18px;margin:0 0 5px;letter-spacing:-.4px}.panel-heading p{font-size:11px;color:var(--muted);margin:0;line-height:1.5}.field-label{display:block;font-size:10px;font-weight:850;color:#345166;margin:17px 0 7px}.field-label span{font-weight:500;color:#8a9ba5}.text-input{width:100%;border:1px solid #d4e0e4;border-radius:7px;padding:11px 12px;background:#fbfdfd;color:#15364b;font:inherit;font-size:12px;resize:vertical}.text-input:focus{outline:2px solid #9de3dd;outline-offset:1px}.upload-control{display:flex;align-items:center;gap:11px;border:1px dashed #b9cbd0;border-radius:8px;padding:12px;cursor:pointer;background:#f9fbfb}.upload-icon{width:34px;height:34px;display:grid;place-items:center;background:#e4f5f2;border-radius:8px;color:#168e88;font-size:21px}.upload-control b,.upload-control small{display:block}.upload-control b{font-size:11px}.upload-control small{font-size:9px;color:#81949f;margin-top:4px}.upload-control input{position:absolute;width:1px;height:1px;opacity:0}.vibe-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.vibe{border:1px solid #dce6e9;background:#fff;border-radius:8px;text-align:left;padding:10px;cursor:pointer;color:#19394e}.vibe b,.vibe small{display:block}.vibe b{font-size:11px}.vibe small{font-size:9px;color:#81949f;margin-top:4px}.vibe.active{border-color:#159c95;background:#edf9f7;box-shadow:inset 0 0 0 1px #159c95}.generate{margin-top:18px;width:100%;border:0;border-radius:8px;padding:13px;background:#07344d;color:white;font-size:12px;font-weight:850;cursor:pointer}.generate span{color:#63d7cb;margin-right:5px}.generate:hover{background:#10506a}.privacy{font-size:9px;line-height:1.6;color:#82939d;margin:12px 0 0}.concepts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}.concept{border:1px solid #dce6e9;border-radius:9px;overflow:hidden;background:#fff;min-width:0}.concept.selected{border:2px solid #159c95;box-shadow:0 0 0 3px #159c9519}.concept-art{height:218px;position:relative;overflow:hidden;padding:15px;color:var(--mock-ink);background:var(--mock-bg)}.mock-brand{position:relative;z-index:2;font-size:8px;letter-spacing:1.5px;font-weight:900;color:var(--mock-accent)}.mock-headline{position:relative;z-index:2;font-family:Georgia,serif;font-size:28px;line-height:.98;letter-spacing:-1px;margin-top:30px;color:var(--mock-ink)}.mock-headline i{color:var(--mock-accent);font-weight:400}.mock-lines{position:relative;z-index:2;width:65%;height:4px;background:var(--mock-line);margin-top:13px;box-shadow:0 8px 0 var(--mock-line),0 16px 0 var(--mock-line)}.mock-photo{position:absolute;right:0;bottom:0;width:57%;height:42%;background-size:cover;background-position:center;clip-path:polygon(12% 0,100% 0,100% 100%,0 100%)}.photo-one{background:linear-gradient(145deg,#9db5b2,#d2c4ae 45%,#607d79)}.photo-two{background:linear-gradient(145deg,#d4c6ad,#8b988e 55%,#3d514c)}.photo-three{background:linear-gradient(145deg,#b6c5b4,#e1d5c1 48%,#8eaa9c)}.mock-button{position:absolute;z-index:2;left:15px;bottom:16px;width:62px;height:17px;background:var(--mock-accent);border-radius:2px}.art-modern{--mock-bg:#edf3f1;--mock-ink:#1d3945;--mock-accent:#178d86;--mock-line:#cbd9d6}.art-luxury{--mock-bg:#172b2a;--mock-ink:#f5eee2;--mock-accent:#c8ad7b;--mock-line:#52635b}.art-warm{--mock-bg:#f0e8dc;--mock-ink:#453c32;--mock-accent:#a56d4c;--mock-line:#d8cabb}.concept-info{padding:11px}.concept-info b,.concept-info small{display:block}.concept-info b{font-size:10px;line-height:1.3}.concept-info small{font-size:8px;color:#84949d;margin-top:5px;line-height:1.4}.choose{width:100%;margin-top:10px;border:1px solid #cbd9dd;background:#fff;border-radius:6px;padding:8px 5px;color:#214357;font-size:9px;font-weight:850;cursor:pointer}.concept.selected .choose{background:#e7f7f4;border-color:#159c95;color:#087e78}.selection-note{margin-top:13px;padding:10px 12px;border-radius:7px;background:#f0f7f6;color:#53706e;font-size:10px;line-height:1.5}.preview-section{max-width:1196px;margin:42px auto 0;padding:0 22px}.preview-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:15px;margin-bottom:15px}.preview-heading h2,.next-steps h2{font-size:25px;letter-spacing:-.8px;margin:0 0 6px}.preview-heading p:not(.eyebrow){font-size:11px;color:#6f8490;margin:0}.preview-label{font-size:9px;letter-spacing:1px;color:#148b85;font-weight:900;border:1px solid #b8ded9;border-radius:30px;padding:7px 10px;white-space:nowrap}.public-preview{--page-bg:#f0f5f2;--page-ink:#1c3b45;--page-accent:#178d86;--page-button:#178d86;--page-serif:Georgia,serif;background:var(--page-bg);color:var(--page-ink);border:1px solid #d3e0e1;border-radius:11px;overflow:hidden;box-shadow:0 15px 40px #183e4a12}.public-preview[data-style="luxury"]{--page-bg:#192c2b;--page-ink:#f5eee2;--page-accent:#d1b783;--page-button:#b79a68;--page-serif:Georgia,serif}.public-preview[data-style="warm"]{--page-bg:#f1e9dd;--page-ink:#493e34;--page-accent:#a56d4c;--page-button:#a56d4c;--page-serif:Georgia,serif}.public-preview[data-style="bold"]{--page-bg:#102b40;--page-ink:#f3f7f7;--page-accent:#56c9bc;--page-button:#56c9bc;--page-serif:Arial,sans-serif}.preview-nav{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 4%;border-bottom:1px solid color-mix(in srgb,var(--page-ink) 15%,transparent)}.preview-brand{display:flex;align-items:center;gap:9px;min-width:0}.preview-brand b{font-size:10px;letter-spacing:1.3px;white-space:nowrap}.preview-logo{width:31px;height:31px;display:grid;place-items:center;background:var(--page-accent);color:var(--page-bg);border-radius:50%;font-size:12px;font-weight:900;overflow:hidden}.preview-logo img{width:100%;height:100%;object-fit:contain}.preview-nav nav{display:flex;gap:22px;font-size:9px;color:var(--page-ink)}.preview-nav>button,.public-copy button{border:0;background:var(--page-button);color:#fff;border-radius:3px;padding:10px 14px;font-size:9px;font-weight:850;white-space:nowrap}.public-preview[data-style="luxury"] .preview-nav>button,.public-preview[data-style="luxury"] .public-copy button,.public-preview[data-style="warm"] .preview-nav>button,.public-preview[data-style="warm"] .public-copy button,.public-preview[data-style="bold"] .preview-nav>button,.public-preview[data-style="bold"] .public-copy button{color:#102b40}.public-hero{display:grid;grid-template-columns:1fr 1fr;min-height:330px}.public-copy{padding:48px 8%;align-self:center}.public-kicker{font-size:8px;letter-spacing:1.5px;font-weight:900;color:var(--page-accent)}.public-copy h3{font-family:var(--page-serif);font-size:clamp(38px,5vw,62px);font-weight:400;letter-spacing:-2px;line-height:.98;margin:19px 0;color:var(--page-ink)}.public-copy h3 i{font-style:italic;color:var(--page-accent)}.public-copy p{font-size:11px;line-height:1.7;max-width:330px;opacity:.78;margin-bottom:20px}.public-image{position:relative;background:linear-gradient(145deg,#a7bcb1,#d5c6ad 46%,#607e79);min-height:280px}.public-preview[data-style="luxury"] .public-image{background:linear-gradient(145deg,#d5c8ac,#6d8077 55%,#243e39)}.public-preview[data-style="warm"] .public-image{background:linear-gradient(145deg,#c6c6a9,#e5d4bc 50%,#9aab91)}.public-preview[data-style="bold"] .public-image{background:linear-gradient(145deg,#577d86,#b2bca9 50%,#203f54)}.image-caption{position:absolute;bottom:18px;left:18px;background:#102b40d9;color:#fff;padding:8px 11px;font-size:8px;letter-spacing:1.4px}.preview-bottom{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:18px 4%;border-top:1px solid color-mix(in srgb,var(--page-ink) 15%,transparent)}.preview-bottom small,.preview-bottom b{display:block}.preview-bottom small{font-size:8px;letter-spacing:1.4px;color:var(--page-accent);font-weight:900}.preview-bottom b{font-family:Georgia,serif;font-size:16px;font-weight:400;margin-top:5px}.sample-listings{display:flex;gap:8px;flex-wrap:wrap}.sample-listings span{font-size:8px;border:1px solid color-mix(in srgb,var(--page-ink) 22%,transparent);border-radius:20px;padding:7px 9px}.preview-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:13px}.save,.reset{border:0;border-radius:7px;padding:10px 14px;font-size:10px;font-weight:850;cursor:pointer}.save{background:#07344d;color:#fff}.reset{background:#fff;border:1px solid #cbd9dd;color:#355367}.preview-actions span{font-size:9px;color:#7c9099}.next-steps{max-width:1152px;margin:45px auto 0;padding:24px 22px;display:grid;grid-template-columns:1.2fr 1fr;gap:25px;border-top:1px solid #dce6e9}.next-steps p{font-size:11px;color:#718591;line-height:1.7;max-width:600px}.next-list{display:grid;align-content:center;gap:11px;font-size:11px;color:#466274}.next-list span:first-child{color:#128b83;font-weight:800}.disclaimer{max-width:1152px;margin:20px auto 0;padding:0 22px;color:#83949c;font-size:9px;line-height:1.6}
@media(max-width:900px){.studio-shell{grid-template-columns:1fr}.concept-art{height:235px}.intro-mark{min-width:175px}.preview-nav nav{gap:12px}}
@media(max-width:620px){.intro{display:block;padding:38px 20px}.intro-mark{margin-top:22px;display:inline-grid}.studio-shell{padding:0 12px;margin-top:14px}.setup-panel,.design-panel{padding:16px}.concepts{grid-template-columns:1fr;gap:10px}.concept{display:grid;grid-template-columns:42% 1fr}.concept-art{height:190px}.concept-info{display:flex;flex-direction:column;justify-content:center}.concept-info b{font-size:11px}.preview-section{padding:0 12px;margin-top:30px}.preview-heading{display:block}.preview-label{display:inline-block;margin-top:10px}.preview-nav{padding:12px;flex-wrap:wrap}.preview-nav nav{order:3;width:100%;justify-content:space-between;font-size:8px}.preview-nav>button{padding:8px 10px}.preview-brand b{font-size:8px}.public-hero{grid-template-columns:1fr}.public-copy{padding:32px 23px}.public-copy h3{font-size:47px}.public-image{min-height:180px}.preview-bottom{display:block;padding:15px}.sample-listings{margin-top:13px}.next-steps{grid-template-columns:1fr;margin-top:28px;padding:20px 16px}.disclaimer{padding:0 16px}}
</style>

<script>
const root = document.querySelector('#realtor-studio');
if (root) {
  const $ = (id) => document.getElementById(id);
  const defaults = { company: 'Oak & Stone Realty', tagline: 'Local guidance. Thoughtful service. Real estate with a personal touch.', vibe: 'modern', selected: 'modern', brandColor: '#178d86' };
  let state = { ...defaults };
  let logoData = '';
  let brandColor = defaults.brandColor;
  const palettes = {
    modern: { bg: '#f0f5f2', ink: '#1c3b45', accent: '#178d86', button: '#178d86', headline: 'A place|to belong.' },
    luxury: { bg: '#192c2b', ink: '#f5eee2', accent: '#d1b783', button: '#b79a68', headline: 'Find your|forever.' },
    warm: { bg: '#f1e9dd', ink: '#493e34', accent: '#a56d4c', button: '#a56d4c', headline: 'Your next|chapter starts here.' },
    bold: { bg: '#102b40', ink: '#f3f7f7', accent: '#56c9bc', button: '#56c9bc', headline: 'Make your|next move.' }
  };
  const mix = (hex, other, amount) => {
    const a = hex.replace('#',''), b = other.replace('#','');
    const out = [0,2,4].map(i => Math.round(parseInt(a.slice(i,i+2),16)*(1-amount)+parseInt(b.slice(i,i+2),16)*amount).toString(16).padStart(2,'0'));
    return '#' + out.join('');
  };
  const contrast = hex => {
    const v = hex.replace('#','');
    const rgb = [0,2,4].map(i => parseInt(v.slice(i,i+2),16));
    return (rgb[0]*299+rgb[1]*587+rgb[2]*114)/1000 > 155 ? '#173447' : '#ffffff';
  };
  const extractColor = file => new Promise(resolve => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      try {
        const canvas = document.createElement('canvas'); canvas.width = 60; canvas.height = 60;
        const ctx = canvas.getContext('2d'); ctx.drawImage(img,0,0,60,60);
        const pixels = ctx.getImageData(0,0,60,60).data; const bins = {};
        for (let i=0;i<pixels.length;i+=16) {
          const r=pixels[i],g=pixels[i+1],b=pixels[i+2],max=Math.max(r,g,b),min=Math.min(r,g,b);
          if (pixels[i+3]<180 || max<45 || min>238 || max-min<22) continue;
          const key=[r,g,b].map(x=>Math.round(x/32)*32).join(',');
          bins[key]=(bins[key]||0)+1;
        }
        const best=Object.entries(bins).sort((a,b)=>b[1]-a[1])[0];
        if (best) resolve('#'+best[0].split(',').map(x=>Math.min(255,Number(x)).toString(16).padStart(2,'0')).join(''));
        else resolve(defaults.brandColor);
      } catch { resolve(defaults.brandColor); }
      URL.revokeObjectURL(url);
    };
    img.onerror=()=>{ URL.revokeObjectURL(url); resolve(defaults.brandColor); };
    img.src=url;
  });
  const apply = () => {
    const p = palettes[state.selected] || palettes.modern;
    const accent = state.selected === 'modern' ? mix(brandColor,'#ffffff',.12) : state.selected === 'luxury' ? mix(brandColor,'#d1b783',.42) : state.selected === 'warm' ? mix(brandColor,'#b77a56',.36) : mix(brandColor,'#ffffff',.04);
    $('public-preview').dataset.style = state.selected;
    $('public-preview').style.setProperty('--page-accent',accent);
    $('public-preview').style.setProperty('--page-button',accent);
    $('preview-company').textContent = (state.company || 'Your Company').toUpperCase();
    $('preview-tagline').textContent = state.tagline || 'A thoughtful real estate experience, built around you.';
    const title = p.headline.split('|');
    $('preview-headline').innerHTML = title[0] + '<br/><i>' + title[1] + '</i>';
    $('preview-logo').innerHTML = logoData ? '<img alt="Uploaded company logo" src="' + logoData + '">' : (state.company.trim().charAt(0).toUpperCase() || 'B');
    $('concepts').querySelectorAll('.concept').forEach(card => card.classList.toggle('selected',card.dataset.concept===state.selected));
    $('selection-note').textContent = state.selected.charAt(0).toUpperCase()+state.selected.slice(1)+' design selected. Brand accent adapted from your logo where possible.';
  };
  const renderConcepts = () => {
    const names = { modern:'Modern & Professional', luxury:'Luxury & Refined', warm:'Warm & Welcoming' };
    const order = state.vibe==='luxury' ? ['luxury','modern','warm'] : state.vibe==='warm' ? ['warm','modern','luxury'] : state.vibe==='bold' ? ['modern','warm','luxury'] : ['modern','luxury','warm'];
    const container=$('concepts');
    order.forEach((key,index)=> {
      const card=container.querySelector('[data-concept="'+key+'"]');
      if(card) container.append(card);
      const button=card?.querySelector('[data-choose]');
      if(button) button.textContent=key===state.selected?'Selected':'Use this look';
    });
    if (state.vibe==='bold') $('selection-note').textContent='We recommend a confident, high-contrast direction. Choose a concept to preview it below.';
  };
  $('company-name').addEventListener('input',e=>{state.company=e.target.value.slice(0,60);apply();});
  $('tagline').addEventListener('input',e=>{state.tagline=e.target.value.slice(0,150);apply();});
  root.querySelectorAll('[data-vibe]').forEach(btn=>btn.addEventListener('click',()=>{state.vibe=btn.dataset.vibe;root.querySelectorAll('[data-vibe]').forEach(x=>x.classList.toggle('active',x===btn));}));
  $('brand-logo').addEventListener('change',async e=>{
    const file=e.target.files?.[0]; if(!file)return;
    if(!/^image\/(png|jpeg|webp)$/.test(file.type)||file.size>2*1024*1024){$('upload-title').textContent='Choose PNG, JPG or WebP under 2 MB';return;}
    logoData=await new Promise(resolve=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result));reader.onerror=()=>resolve('');reader.readAsDataURL(file);});
    brandColor=await extractColor(file);
    $('upload-title').textContent=file.name;
    $('selection-note').textContent='Logo loaded. Create your three concepts to explore logo-informed colors and layouts.';
    apply();
  });
  $('generate').addEventListener('click',()=>{
    const first=state.vibe==='luxury'?'luxury':state.vibe==='warm'?'warm':'modern';
    state.selected=first;renderConcepts();apply();
    $('selection-note').textContent='Three design directions are ready. Choose any card to compare the public-page preview.';
    $('concepts').scrollIntoView({behavior:'smooth',block:'nearest'});
  });
  root.querySelectorAll('[data-choose]').forEach(btn=>btn.addEventListener('click',()=>{
    state.selected=btn.dataset.choose;renderConcepts();apply();
    $('selection-note').textContent='Selected '+state.selected+' design. The public-page preview has updated.';
  }));
  $('save-design').addEventListener('click',()=>{
    try{localStorage.setItem('brokerpal-realtor-design-preview',JSON.stringify({...state,brandColor}));$('save-status').textContent='Design settings saved on this device only.';}
    catch{$('save-status').textContent='Browser storage is unavailable. Your current preview remains active.';}
  });
  $('reset-design').addEventListener('click',()=>{
    state={...defaults};brandColor=defaults.brandColor;logoData='';$('company-name').value=state.company;$('tagline').value=state.tagline;$('brand-logo').value='';$('upload-title').textContent='Choose a logo';
    root.querySelectorAll('[data-vibe]').forEach(x=>x.classList.toggle('active',x.dataset.vibe==='modern'));
    try{localStorage.removeItem('brokerpal-realtor-design-preview');}catch{}
    renderConcepts();apply();$('save-status').textContent='Preview reset.';
  });
  try{
    const saved=localStorage.getItem('brokerpal-realtor-design-preview');
    if(saved){const parsed=JSON.parse(saved);state={...defaults,...parsed};brandColor=parsed.brandColor||defaults.brandColor;$('company-name').value=state.company;$('tagline').value=state.tagline;root.querySelectorAll('[data-vibe]').forEach(x=>x.classList.toggle('active',x.dataset.vibe===state.vibe));renderConcepts();}
  }catch{}
  apply();
}
</script>
