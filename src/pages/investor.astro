.history-explainer-grid h3{font-size:19px;color:#f2f7f8;margin:0 0 12px}
.history-explainer-grid ul{padding-left:19px;margin:0}
.history-explainer-grid li{font-size:13px;color:#c3d2da;margin:10px 0;line-height:1.55}
.history-explainer-grid b{color:#f4f8f9}
.history-callout{margin-top:20px;padding:22px 24px;border-left:3px solid #68d9ce;background:#102d43}
.history-callout>b{color:#f3f7f8;font-size:17px}
.history-callout p{color:#c3d2da;font-size:13px;line-height:1.65;margin:9px 0 0}
.history-source-links{display:flex;flex-wrap:wrap;gap:12px 22px;margin-top:20px}
.history-source-links a{color:#69d9ce;font-size:12px;font-weight:750;text-decoration:none}
.history-source-links a:hover{text-decoration:underline}
@media(max-width:720px){.history-stat-grid{grid-template-columns:1fr}.history-explainer-grid{grid-template-columns:1fr}.history-chart-card{padding:16px}.history-chart-wrap svg{min-height:180px}}
</style>
<script>
const rentInput = document.querySelector('#monthly-rent');
const pitiaInput = document.querySelector('#monthly-pitia');
const result = document.querySelector('#dscr-result');
const explanation = document.querySelector('#dscr-explanation');
function updateDscr() {
  const rent = Number(rentInput?.value || 0);
  const pitia = Number(pitiaInput?.value || 0);
  if (!result || !explanation) return;
  if (rent <= 0 || pitia <= 0) {
    result.textContent = '—';
    explanation.textContent = 'Enter positive monthly rent and PITIA amounts.';
    return;
  }
  const ratio = rent / pitia;
  result.textContent = ratio.toFixed(2) + '×';
  explanation.textContent = '$' + ratio.toFixed(2) + ' of qualifying rent for each $1.00 of PITIA.';
}
rentInput?.addEventListener('input', updateDscr);
pitiaInput?.addEventListener('input', updateDscr);

function numericValue(id) {
  const element = document.getElementById(id);
  const value = Number(element?.value ?? 0);
  return Number.isFinite(value) ? Math.max(0, value) : 0;
}
function updateLongTermEstimate() {
  const rent = numericValue('lt-rent');
  const pitia = numericValue('lt-pitia');
  const management = rent * numericValue('lt-management') / 100;
  const vacancy = rent * numericValue('lt-vacancy') / 100;
  const maintenance = rent * numericValue('lt-maintenance') / 100;
  const other = numericValue('lt-other');
  const net = rent - pitia - management - vacancy - maintenance - other;
  const result = document.getElementById('lt-result');
  const detail = document.getElementById('lt-detail');
  if (result) result.textContent = (net < 0 ? '-$' : '$') + Math.abs(Math.round(net)).toLocaleString('en-US');
  if (detail) detail.textContent = 'Monthly allowances: management $' + Math.round(management) + ', vacancy $' + Math.round(vacancy) + ', maintenance $' + Math.round(maintenance) + ', other $' + Math.round(other) + '. Before taxes and major capital projects.';
}
function updateShortTermEstimate() {
  const rate = numericValue('st-rate');
  const occupancy = Math.min(100, numericValue('st-occupancy'));
  const pitia = numericValue('st-pitia');
  const costs = numericValue('st-costs');
  const gross = rate * 30 * occupancy / 100;
  const net = gross - pitia - costs;
  const breakEven = rate > 0 ? (pitia + costs) / (rate * 30) * 100 : Infinity;
  const result = document.getElementById('st-result');
  const detail = document.getElementById('st-detail');
  if (result) result.textContent = (net < 0 ? '-
 : '
) + Math.abs(Math.round(net)).toLocaleString('en-US');
  if (detail) detail.textContent = 'Estimated monthly gross bookings: 
 + Math.round(gross).toLocaleString('en-US') + ' · Break-even occupancy: ' + (Number.isFinite(breakEven) ? breakEven.toFixed(1) + '%' : 'not available') + '.';
}
['lt-rent','lt-pitia','lt-management','lt-vacancy','lt-maintenance','lt-other'].forEach(id => document.getElementById(id)?.addEventListener('input', updateLongTermEstimate));
['st-rate','st-occupancy','st-pitia','st-costs'].forEach(id => document.getElementById(id)?.addEventListener('input', updateShortTermEstimate));
updateLongTermEstimate();
updateShortTermEstimate();

const homePriceHistory = [
[1975,62.31],[1976,67.28],[1977,77.19],[1978,87.46],[1979,98.26],[1980,104.55],[1981,107.49],[1982,111.56],[1983,117.55],[1984,123.05],[1985,130.08],[1986,139.57],[1987,147.16],[1988,155.43],[1989,164.15],[1990,166.14],[1991,171.32],[1992,175.45],[1993,180.11],[1994,182.89],[1995,191.23],[1996,196.05],[1997,204.65],[1998,215.02],[1999,225.58],[2000,241.54],[2001,258.74],[2002,276.08],[2003,295.33],[2004,325.86],[2005,362.49],[2006,378.91],[2007,374.59],[2008,347.78],[2009,329.73],[2010,323.64],[2011,312.84],[2012,314.69],[2013,328.17],[2014,344.88],[2015,362.20],[2016,381.92],[2017,402.55],[2018,422.16],[2019,443.49],[2020,471.28],[2021,556.16],[2022,616.15],[2023,648.40],[2024,683.47],[2025,707.22]
];
const mortgageRateMilestones = [[1971,7.54],[1981,16.64],[1991,9.25],[2001,6.97],[2011,4.45],[2021,2.96],[2025,6.60]];
function drawHousingHistory(kind) {
 const svg=document.getElementById('housing-history-chart');
 if(!svg)return;
 const prices=kind==='prices';
 const data=prices?homePriceHistory:mortgageRateMilestones;
 const title=document.getElementById('history-chart-title');
 const subtitle=document.getElementById('history-chart-subtitle');
 const legend=document.getElementById('history-legend-label');
 const range=document.getElementById('history-chart-range');
 const note=document.getElementById('history-chart-note');
 if(title)title.textContent=prices?'U.S. home-price index':'30-year fixed mortgage rates';
 if(subtitle)subtitle.textContent=prices?'FHFA All-Transactions HPI · fourth-quarter observations · 1975–2025':'Freddie Mac PMMS · selected annual-average milestones · 1971–2025';
 if(legend)legend.textContent=prices?'FHFA home-price index (1980 Q1 = 100)':'Average 30-year fixed mortgage rate (%)';
 if(range)range.textContent=prices?'1975–2025':'1971–2025 · selected years';
 if(note)note.textContent=prices?'An index tracks changes over time; it is not the average dollar price of a home. FHFA uses repeat-sales and appraisal data for single-family properties associated with conventional conforming mortgages.':'These are selected annual-average milestones, not every year or weekly rate. Freddie Mac PMMS began in 1971; actual borrower rates vary by loan type, credit, points, and other factors.';
 const W=900,H=360,L=76,R=26,T=24,B=48,plotW=W-L-R,plotH=H-T-B;
 const xs=data.map(d=>d[0]),ys=data.map(d=>d[1]);
 const minX=xs[0],maxX=xs[xs.length-1],minY=0,maxY=prices?800:20;
 const x=v=>L+(v-minX)/(maxX-minX)*plotW;
 const y=v=>T+(maxY-v)/(maxY-minY)*plotH;
 let out='';
 const ticks=prices?[0,200,400,600,800]:[0,5,10,15,20];
 ticks.forEach(v=>{const yy=y(v);out+=`<line x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}" stroke="#345266" stroke-width="1"/><text x="${L-12}" y="${yy+4}" fill="#a9bfca" font-size="12" text-anchor="end">${prices?v:v+'%'}</text>`;});
 const yearTicks=prices?[1975,1985,1995,2005,2015,2025]:[1971,1981,1991,2001,2011,2021,2025];
 yearTicks.forEach(v=>{const xx=x(v);out+=`<text x="${xx}" y="${H-16}" fill="#a9bfca" font-size="12" text-anchor="middle">${v}</text>`;});
 const points=data.map(d=>x(d[0])+','+y(d[1])).join(' ');
 out+=`<polyline points="${points}" fill="none" stroke="#68d9ce" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>`;
 data.forEach((d,i)=>{const xx=x(d[0]),yy=y(d[1]);out+=`<circle cx="${xx}" cy="${yy}" r="4.5" fill="#68d9ce" stroke="#0a1f30" stroke-width="2"><title>${d[0]}: ${prices?d[1].toFixed(2):d[1].toFixed(2)+'%'}</title></circle>`;});
 const annotations=prices?[[2006,'Pre-crash peak'],[2011,'Housing downturn'],[2025,'Latest']]:[[1981,'Rate peak'],[2021,'Rate low'],[2025,'Latest']];
 annotations.forEach(a=>{const d=data.find(p=>p[0]===a[0]);if(!d)return;const xx=x(d[0]),yy=y(d[1]);const labelY=Math.max(T+14,yy-18);out+=`<text x="${xx}" y="${labelY}" fill="#e7f1f3" font-size="11" text-anchor="middle">${a[1]}</text>`;});
 out+=`<text x="${L}" y="14" fill="#a9bfca" font-size="11">${prices?'Index value':'Interest rate'}</text>`;
 svg.innerHTML=out;
 svg.setAttribute('aria-label',prices?'FHFA national home-price index from 1975 to 2025, with a decline during the housing crisis':'Selected annual average 30-year fixed mortgage rates from 1971 to 2025');
 document.querySelectorAll('.history-tab').forEach(btn=>{const active=btn.dataset.chart===kind;btn.classList.toggle('active',active);btn.setAttribute('aria-pressed',String(active));});
}
document.querySelectorAll('.history-tab').forEach(btn=>btn.addEventListener('click',()=>drawHousingHistory(btn.dataset.chart)));
drawHousingHistory('prices');
</script>
