.secondary{border:1px solid #638397;color:#edf5f7}.secondary:hover{border-color:#65d4c8;color:#65d4c8}
.hero-copy>small{font-size:12px;color:#9fb5c2}
.hero-stat{padding:30px;border:1px solid #2d6677;background:linear-gradient(145deg,#143e53,#0b2639);border-radius:10px;box-shadow:0 24px 60px #0004;display:flex;flex-direction:column;align-items:center;text-align:center}
.hero-stat>span,.calc-result>span{font-size:10px;letter-spacing:1.8px;font-weight:800;color:#8fb7c3}
.hero-stat>strong{font-size:82px;line-height:1.15;color:#6bdbcf;letter-spacing:-4px}.hero-stat>strong small{font-size:34px}
.hero-stat>b{font-size:15px;color:#f4f8fa}.hero-stat>i{font-style:normal;color:#70cfc5;font-size:22px}.hero-stat>p{font-size:12px;color:#9fb5c2;margin-bottom:0}
.intro-section{max-width:960px;margin:auto}
.intro-section h2,.benefits-section h2,.calculator-section h2,.property-count-section h2,.facts-section h2,.process-section h2,.faq-section h2,.closing-cta h2{font-size:clamp(30px,3.4vw,43px);line-height:1.15;letter-spacing:-1.4px;margin:14px 0 22px}
.intro-section p,.property-count-section p,.calculator-copy p{color:#c1d0d8;max-width:900px}
.benefits-section,.facts-section{background:#0c2234}
.benefit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:32px}
.benefit-grid article,.facts-grid article{background:#102d43;border:1px solid #24445a;border-radius:7px;padding:25px}
.benefit-grid article>span{font-size:12px;color:#62d2c6;font-weight:850;letter-spacing:1.5px}
.benefit-grid h3,.facts-grid h3{font-size:19px;margin:12px 0 8px}
.benefit-grid p,.facts-grid p,.process-grid p{font-size:14px;color:#b6c8d2;margin:0}
.fine-print{font-size:12px!important;color:#92aab8!important;line-height:1.6;margin-top:22px}
.calculator-section{display:grid;grid-template-columns:1fr .9fr;gap:60px;align-items:center}
.calc-note{border-left:3px solid #5bd0c4;padding:12px 18px;margin-top:28px;background:#102d43;display:grid;gap:4px}
.calc-note b{color:#69d5ca;font-size:12px;text-transform:uppercase;letter-spacing:1px}.calc-note span{color:#d5e2e8;font-size:14px}
.calculator-card{background:#102d43;border:1px solid #2b4d61;border-radius:8px;padding:28px;display:grid;gap:10px}
.calculator-card label{font-size:13px;color:#d4e0e6;font-weight:700;margin-top:6px}
.calculator-card input{width:100%;box-sizing:border-box;background:#071b2b;border:1px solid #456477;border-radius:4px;padding:13px;color:#fff;font-size:18px}
.calculator-card input:focus{outline:2px solid #5bd0c4;outline-offset:1px}
.calc-result{margin-top:12px;padding:20px;background:#0a2538;border-radius:6px;display:grid;gap:3px;text-align:center}
.calc-result strong{font-size:48px;color:#6bd9ce;line-height:1.2}
.calc-result small{font-size:12px;color:#c0d1d9}
.count-layout{display:grid;grid-template-columns:.65fr 1.35fr;gap:38px;align-items:start}
.count-highlight{background:#10344a;border:1px solid #2d6677;border-radius:8px;padding:25px;display:grid;gap:8px}
.count-highlight strong{font-size:78px;line-height:1;color:#69d9ce}.count-highlight span{font-size:14px;color:#d4e2e8}
.text-link{display:inline-block;color:#69d9ce;font-size:14px;font-weight:750;text-decoration:none;margin-top:8px}.text-link:hover{text-decoration:underline}
.facts-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-top:28px}
.facts-grid article>b{font-size:32px;color:#69d9ce;letter-spacing:-1px}
.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px}
.process-grid>div{padding:23px;border-top:2px solid #5bd0c4;background:#102d43}
.process-grid b{color:#6bd9ce;font-size:18px}
.faq-section{background:#0c2234}
.faq-section details{border-bottom:1px solid #2a4659;padding:17px 0}
.faq-section summary{cursor:pointer;font-weight:750;color:#edf5f7}
.faq-section details p{color:#b9cbd5;font-size:14px;max-width:900px}
.closing-cta{display:flex;align-items:center;justify-content:space-between;gap:30px;background:linear-gradient(110deg,#123c50,#0c293e)}
.closing-cta p{color:#c4d3dc;margin-bottom:0}
.disclaimer{max-width:1100px;margin:0 auto;padding:0 28px 42px;color:#819baa;font-size:11px;line-height:1.6}
@media(max-width:850px){.investor-hero,.calculator-section{grid-template-columns:1fr;gap:30px}.hero-stat{max-width:420px}.benefit-grid{grid-template-columns:repeat(2,1fr)}.facts-grid{grid-template-columns:repeat(2,1fr)}.count-layout{grid-template-columns:1fr}.process-grid{grid-template-columns:1fr}}
@media(max-width:560px){.investor-page section{padding:52px 22px}.investor-hero h1{font-size:42px}.benefit-grid,.facts-grid{grid-template-columns:1fr}.closing-cta{display:block}.closing-cta .button{margin-top:24px}.calculator-card{padding:20px}.hero-stat{padding:24px}.disclaimer{padding:0 22px 32px}}

.llc-section,.rental-strategy-section,.rental-tools-section,.management-section{background:#0a1f30}
.section-intro{color:#bfd0d9;max-width:950px;margin:0 0 28px}
.llc-grid,.strategy-grid,.tool-grid,.operations-grid,.management-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:26px}
.llc-grid article,.llc-steps,.strategy-grid article,.tool-card,.operations-card,.management-grid>div{background:#102d43;border:1px solid #294c61;border-radius:7px;padding:24px}
.llc-section h3,.rental-strategy-section h3,.rental-tools-section h3,.management-section h3{color:#f0f6f8;font-size:20px;margin:0 0 12px}
.llc-section li,.strategy-grid li,.management-section li{color:#c1d1d9;margin:8px 0}
.llc-steps{margin-top:18px}.llc-steps ol{padding-left:22px}.llc-steps li{padding:5px 0;color:#c3d2da}
.resource-links{display:flex;flex-wrap:wrap;gap:12px 22px;margin-top:18px}
.resource-links a{color:#69d9ce;font-size:13px;font-weight:750;text-decoration:none}.resource-links a:hover{text-decoration:underline}
.strategy-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
.strategy-tag{display:inline-block;color:#67d8cd;font-size:10px;font-weight:850;letter-spacing:1.5px;margin-bottom:12px}
.strategy-grid p{color:#bdcdd6;font-size:14px}
.strategy-grid b{color:#f2f7f8;font-size:13px}
.tool-card>p,.operations-card>p{font-size:13px;color:#b8cbd5}
.tool-fields{display:grid;grid-template-columns:1fr 1fr;gap:8px 12px;margin-top:18px}
.tool-fields label{font-size:12px;color:#c9d8df;align-self:center}
.tool-fields input{width:100%;box-sizing:border-box;min-width:0;background:#071b2b;border:1px solid #456477;border-radius:4px;padding:10px;color:#fff;font-size:15px}
.tool-fields input:focus{outline:2px solid #5bd0c4;outline-offset:1px}
.tool-result{display:grid;gap:4px;text-align:center;margin-top:18px;padding:17px;background:#09263a;border-radius:6px}
.tool-result span{font-size:10px;letter-spacing:1.4px;color:#9fc1ca;font-weight:800}
.tool-result strong{font-size:34px;color:#6bd9ce}
.tool-result small{font-size:11px;color:#c0d0d8}
.operations-grid{margin-top:20px}
.checklist{display:grid;gap:11px;margin-top:18px}
.checklist label{display:flex;gap:10px;align-items:flex-start;color:#c3d2da;font-size:13px}
.checklist input{accent-color:#5bd0c4;margin-top:4px;flex:0 0 auto}
.management-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.management-grid ul{padding-left:20px}
@media(max-width:850px){.strategy-grid{grid-template-columns:1fr}.llc-grid,.tool-grid,.operations-grid,.management-grid{grid-template-columns:1fr}}
@media(max-width:560px){.llc-grid article,.llc-steps,.strategy-grid article,.tool-card,.operations-card,.management-grid>div{padding:19px}.tool-fields{grid-template-columns:1fr}.tool-fields label{margin-top:5px}}
</style>
<script>
const rentInput = document.querySelector('#monthly-rent');
const pitiaInput = document.querySelector('#monthly-pitia');
const result = document.querySelector('#dscr-result');
const explanation = document.querySelector('#dscr-explanation');
function updateDscr() {
  const rent = Number(rentInput?.value || 0);
  const pitia = Number(pitiaInput?.value || 0);
  if (!result || !explanation) return;
  if (rent <= 0 || pitia <= 0) {
    result.textContent = '—';
    explanation.textContent = 'Enter positive monthly rent and PITIA amounts.';
    return;
  }
  const ratio = rent / pitia;
  result.textContent = ratio.toFixed(2) + '×';
  explanation.textContent = '$' + ratio.toFixed(2) + ' of qualifying rent for each $1.00 of PITIA.';
}
rentInput?.addEventListener('input', updateDscr);
pitiaInput?.addEventListener('input', updateDscr);

function numericValue(id) {
  const element = document.getElementById(id);
  const value = Number(element?.value ?? 0);
  return Number.isFinite(value) ? Math.max(0, value) : 0;
}
function updateLongTermEstimate() {
  const rent = numericValue('lt-rent');
  const pitia = numericValue('lt-pitia');
  const management = rent * numericValue('lt-management') / 100;
  const vacancy = rent * numericValue('lt-vacancy') / 100;
  const maintenance = rent * numericValue('lt-maintenance') / 100;
  const other = numericValue('lt-other');
  const net = rent - pitia - management - vacancy - maintenance - other;
  const result = document.getElementById('lt-result');
  const detail = document.getElementById('lt-detail');
  if (result) result.textContent = (net < 0 ? '-
 : '
) + Math.abs(Math.round(net)).toLocaleString('en-US');
  if (detail) detail.textContent = 'Monthly allowances: management 
 + Math.round(management) + ', vacancy 
 + Math.round(vacancy) + ', maintenance 
 + Math.round(maintenance) + ', other 
 + Math.round(other) + '. Before taxes and major capital projects.';
}
function updateShortTermEstimate() {
  const rate = numericValue('st-rate');
  const occupancy = Math.min(100, numericValue('st-occupancy'));
  const pitia = numericValue('st-pitia');
  const costs = numericValue('st-costs');
  const gross = rate * 30 * occupancy / 100;
  const net = gross - pitia - costs;
  const breakEven = rate > 0 ? (pitia + costs) / (rate * 30) * 100 : Infinity;
  const result = document.getElementById('st-result');
  const detail = document.getElementById('st-detail');
  if (result) result.textContent = (net < 0 ? '-
 : '
) + Math.abs(Math.round(net)).toLocaleString('en-US');
  if (detail) detail.textContent = 'Estimated monthly gross bookings: 
 + Math.round(gross).toLocaleString('en-US') + ' · Break-even occupancy: ' + (Number.isFinite(breakEven) ? breakEven.toFixed(1) + '%' : 'not available') + '.';
}
['lt-rent','lt-pitia','lt-management','lt-vacancy','lt-maintenance','lt-other'].forEach(id => document.getElementById(id)?.addEventListener('input', updateLongTermEstimate));
['st-rate','st-occupancy','st-pitia','st-costs'].forEach(id => document.getElementById(id)?.addEventListener('input', updateShortTermEstimate));
updateLongTermEstimate();
updateShortTermEstimate();
</script>
