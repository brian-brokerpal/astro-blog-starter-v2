---
import Layout from '../../layouts/BlogPost.astro';
---
<section class="tool"><p class="kicker">INVESTOR TOOLKIT</p><h1>Property Data Report</h1><p class="lead">Create a preliminary 1–4 unit investment-property worksheet and open public-record research sources for the address.</p>
<div class="panel"><label>Property address<input id="address" placeholder="123 Main Street, Atlanta, GA"></label><div class="two"><label>Property type<select id="type"><option>Single-family</option><option>Duplex</option><option>Triplex</option><option>Fourplex</option></select></label><label>Occupancy<select id="occupancy"><option>Tenant occupied</option><option>Vacant</option><option>Owner occupied</option><option>Unknown</option></select></label></div><div class="two"><label>Estimated value ($)<input id="value" type="number" placeholder="350000"></label><label>Estimated monthly rent ($)<input id="rent" type="number" placeholder="2800"></label></div><div class="two"><label>Annual property tax ($)<input id="tax" type="number" placeholder="4200"></label><label>Annual insurance ($)<input id="insurance" type="number" placeholder="1800"></label></div><label>Notes<textarea id="notes" rows="3" placeholder="Repairs, condition, rent assumptions..."></textarea></label><button id="make" type="button">Build my report</button></div>
<section id="report" class="report" hidden><div class="reporthead"><div><span>BROKER PAL · INVESTMENT LOANS</span><h2>Preliminary Property Worksheet</h2><b id="raddress"></b></div><button id="print" type="button">Print / Save PDF</button></div><div class="facts" id="facts"></div><p id="rnotes"></p><h3>Public-record research links</h3><ul id="links"></ul><p class="disclaimer">This worksheet uses information entered by the user and does not independently verify ownership, valuation, taxes, zoning, liens, flood status, rental legality, or property condition. Confirm all information with authoritative public records and qualified professionals.</p><a id="email" class="cta">Email this worksheet summary</a></section></section>
<script>
const get=id=>document.getElementById(id);const fmt=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n||0);
get('make').addEventListener('click',()=>{const a=get('address').value.trim();if(!a){get('address').focus();return}const val=Number(get('value').value)||0,rent=Number(get('rent').value)||0;get('raddress').textContent=a;get('facts').innerHTML=[['Property type',get('type').value],['Occupancy',get('occupancy').value],['Estimated value',fmt(val)],['Monthly rent',fmt(rent)],['Annualized gross rent',fmt(rent*12)],['Gross rent yield',val?(rent*12/val*100).toFixed(2)+'%':'Not provided'],['Annual property tax',fmt(Number(get('tax').value))],['Annual insurance',fmt(Number(get('insurance').value))]].map(x=>'<div><small>'+x[0]+'</small><b>'+x[1]+'</b></div>').join('');get('rnotes').textContent=get('notes').value?'Notes: '+get('notes').value:'';const q=encodeURIComponent(a);const sources=[['County assessor / property records','https://www.google.com/search?q='+q+'+county+property+assessor+records'],['FEMA flood map','https://msc.fema.gov/portal/search?Address='+q],['Google Maps','https://www.google.com/maps/search/?api=1&query='+q],['HUD fair market rent resources','https://www.huduser.gov/portal/datasets/fmr.html']];get('links').innerHTML=sources.map(s=>'<li><a target="_blank" rel="noopener" href="'+s[1]+'">'+s[0]+'</a></li>').join('');get('email').href='mailto:brian@yourbrokerpal.com?subject='+encodeURIComponent('Property worksheet: '+a)+'&body='+encodeURIComponent('Preliminary property worksheet for '+a+'. Estimated value: '+fmt(val)+'. Monthly rent: '+fmt(rent)+'. Please contact me to discuss.');get('report').hidden=false;get('report').scrollIntoView({behavior:'smooth'});});
get('print').addEventListener('click',()=>window.print());
</script>
<style>
.tool{max-width:900px;margin:auto;padding:38px 22px 70px;color:#20374e}.kicker{font-size:11px;letter-spacing:2px;color:#078f9d;font-weight:800}.tool h1{font-size:clamp(38px,5vw,54px);color:#102b49;margin:12px 0}.lead{color:#63768a}.panel{background:#f0f5f6;padding:24px;border-top:4px solid #079eaa;display:grid;gap:15px;margin:25px 0}.panel label{font-size:13px;font-weight:700}.panel input,.panel select,.panel textarea{display:block;box-sizing:border-box;width:100%;padding:12px;margin-top:6px;border:1px solid #cbd8df;border-radius:4px;background:white;font-size:16px}.two{display:grid;grid-template-columns:1fr 1fr;gap:15px}.panel button,.cta{background:#078f9d;color:#102b49;border:0;padding:13px 18px;font-weight:800;text-decoration:none;width:max-content;cursor:pointer}.report{border:1px solid #d7e2e7;padding:24px;margin-top:30px}.reporthead{display:flex;justify-content:space-between;gap:20px;align-items:center}.reporthead span{font-size:10px;letter-spacing:1.5px;color:#078f9d;font-weight:800}.report h2{font-size:25px;color:#102b49;margin:8px 0}.reporthead button{padding:10px;border:1px solid #b8cbd4;background:white}.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:25px 0}.facts div{background:#f0f5f6;padding:13px}.facts small{display:block;color:#078f9d}.facts b{color:#102b49}.report h3{color:#102b49}.report li{margin:8px 0}.report a{color:#078f9d}.disclaimer{font-size:12px;color:#718295;line-height:1.7;margin:20px 0}@media(max-width:650px){.two{grid-template-columns:1fr}.facts{grid-template-columns:1fr 1fr}.reporthead{align-items:flex-start;flex-direction:column}}@media print{header,footer,.panel,.kicker,.lead,.reporthead button,.cta{display:none!important}.report{border:0}.tool{padding:0}.facts{grid-template-columns:repeat(4,1fr)}}
</style>