---
import Layout from '../../layouts/BlogPost.astro';
---
<Layout title="Free Investment Property Data Report | broker pal" description="Generate an investment property research report with automated location, Census and FEMA flood data.">
<section class="tool">
<p class="kicker">BROKER PAL INVESTOR TOOLKIT</p><h1>Investment Property Report</h1>
<p class="lead">Enter an address to build a useful first-look report for a 1–4 unit investment property. We'll retrieve available public location and hazard data, calculate key rental metrics, and organize the next research steps.</p>
<div class="panel">
<label>Property street address<input id="address" autocomplete="street-address" placeholder="123 Main Street"></label>
<div class="two"><label>City<input id="city" autocomplete="address-level2" placeholder="Atlanta"></label><label>State<input id="state" maxlength="2" autocomplete="address-level1" placeholder="GA"></label></div>
<div class="two"><label>ZIP code<input id="zip" autocomplete="postal-code" inputmode="numeric" placeholder="30303"></label><label>Property type<select id="type"><option>Single-family</option><option>Duplex</option><option>Triplex</option><option>Fourplex</option></select></label></div>
<div class="two"><label>Estimated market value ($)<input id="value" type="number" min="0" placeholder="350000"></label><label>Estimated monthly rent ($)<input id="rent" type="number" min="0" placeholder="2800"></label></div>
<div class="two"><label>Annual property tax ($)<input id="tax" type="number" min="0" placeholder="4200"></label><label>Annual insurance ($)<input id="insurance" type="number" min="0" placeholder="1800"></label></div>
<label>Known repairs / condition / other notes<textarea id="notes" rows="3" placeholder="Roof age, updates, deferred maintenance, rent assumptions..."></textarea></label>
<button id="make" type="button">Research address & build report</button><p id="status" class="status" role="status">Public data lookup runs when you build the report. No paid data subscription is used.</p>
</div>
<section id="report" class="report" hidden>
<div class="reporthead"><div><span>BROKER PAL · INVESTMENT LOANS</span><h2>Investment Property Intelligence Report</h2><b id="raddress"></b><p id="generated"></p></div><button id="print" type="button">Print / Save PDF</button></div>
<div class="section"><h3>Property snapshot</h3><div class="facts" id="facts"></div></div>
<div class="section"><h3>Automated public data</h3><div id="publicdata" class="data-grid"></div></div>
<div class="section"><h3>Investment metrics</h3><div class="facts" id="metrics"></div><p class="muted">Gross yield is annual gross rent divided by estimated value. It is not a cap rate or cash-on-cash return.</p></div>
<div class="section"><h3>Location & research</h3><div id="maplink"></div><ul id="links"></ul></div>
<div class="section"><h3>Property notes</h3><p id="rnotes"></p></div>
<div class="section"><h3>Next diligence items</h3><ul><li>Confirm ownership, legal description, parcel ID, assessed value and tax balance with the county assessor / tax commissioner.</li><li>Verify zoning, legal unit count, permits, rental registration and any local licensing requirements.</li><li>Review title, liens, code violations, insurance quote, flood insurance requirements and property condition.</li><li>Validate market rent with current comparable rentals and confirm lease terms, deposits and occupancy.</li></ul></div>
<p class="disclaimer">Data availability varies by address and public source. Automated results are informational and may be incomplete or outdated. This report does not verify ownership, value, taxes, liens, zoning, legal unit count, rental legality, insurance eligibility, flood insurance cost, condition or market rent. Confirm all information with authoritative records and qualified professionals. No loan approval, valuation or legal opinion is provided.</p>
<a id="email" class="cta">Email this report summary to Broker Pal</a>
</section></section>
<script>
const el=id=>document.getElementById(id), val=id=>Math.max(0,Number(el(id).value)||0), fmt=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n||0);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function cards(target,items){el(target).innerHTML=items.map(([k,v])=>'<div><small>'+esc(k)+'</small><b>'+esc(v)+'</b></div>').join('')}
function link(label,url){return '<li><a target="_blank" rel="noopener noreferrer" href="'+url+'">'+esc(label)+' ↗</a></li>'}
async function getJson(url){const r=await fetch(url,{headers:{Accept:'application/json'}});if(!r.ok)throw new Error('Source returned '+r.status);return r.json()}
async function research(){
 const address=[el('address').value.trim(),el('city').value.trim(),el('state').value.trim(),el('zip').value.trim()].filter(Boolean).join(', ');
 if(!el('address').value.trim()||!el('city').value.trim()||!el('state').value.trim()){el('status').textContent='Enter the street address, city and state to research this property.';return}
 el('make').disabled=true;el('status').textContent='Looking up the address and checking public data sources…';
 const value=val('value'),rent=val('rent'),tax=val('tax'),insurance=val('insurance');
 const property=[['Property type',el('type').value],['Estimated value',value?fmt(value):'Not entered'],['Estimated monthly rent',rent?fmt(rent):'Not entered'],['Annual property tax',tax?fmt(tax):'Not entered'],['Annual insurance',insurance?fmt(insurance):'Not entered']];
 cards('facts',property);el('raddress').textContent=address;el('generated').textContent='Report generated '+new Date().toLocaleString();
 const publicItems=[];let geo=null,geoError='';
 try{
  const q=encodeURIComponent(address);
  const g=await getJson('https://geocoding.geo.census.gov/geocoder/locations/onelineaddress?address='+q+'&benchmark=Public_AR_Current&format=json');
  const m=g?.result?.addressMatches?.[0];
  if(m){geo=m;const c=m.geographies?.['Census Tracts']?.[0]||{};const s=m.addressComponents||{};publicItems.push(['Address match',m.matchedAddress||address],['Coordinates',m.coordinates?m.coordinates.y.toFixed(5)+', '+m.coordinates.x.toFixed(5):'Available'],['County',c.COUNTY?c.NAME+' County, '+(c.STATE||''):'Not returned'],['Census tract',c.TRACT||'Not returned'],['Census block group',c.BLKGRP||'Not returned'],['Census GEOID',c.GEOID||'Not returned']);}
  else geoError='The Census geocoder did not return a match. Check the address spelling and ZIP code.';
 }catch(e){geoError='Census geocoding is temporarily unavailable ('+e.message+').'}
 let flood='Not checked';let floodNote='Address coordinates are needed to query FEMA flood mapping.';
 if(geo?.coordinates){
  const x=geo.coordinates.x,y=geo.coordinates.y;
  try{
   const url='https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer/identify?f=json&tolerance=2&returnGeometry=false&returnFieldName=true&imageDisplay=800%2C600%2C96&mapExtent='+(x-0.002)+','+(y-0.002)+','+(x+0.002)+','+(y+0.002)+'&geometry='+x+','+y+'&geometryType=esriGeometryPoint&sr=4326&layers=all';
   const data=await getJson(url);const matches=(data.results||[]).filter(z=>/flood hazard|special flood|sfha|flood zone/i.test(z.layerName||''));
   if(matches.length){const attrs=matches[0].attributes||{};flood=attrs.FLD_ZONE||attrs.ZONE_SUBTY||attrs.SFHA_TF||matches[0].value||'FEMA flood layer intersected';floodNote='FEMA National Flood Hazard Layer identify result. Review the official map for exact parcel boundaries and insurance requirements.';}
   else {flood='No matching flood-zone feature returned';floodNote='This is not a determination that the property is outside a flood hazard area. Check the official FEMA map.'}
  }catch(e){flood='Could not retrieve FEMA layer';floodNote='Use the official FEMA map link below to check the address.'}
 }
 publicItems.push(['FEMA flood layer',flood],['Flood data note',floodNote]);
 if(geoError)publicItems.push(['Geocoding status',geoError]);
 cards('publicdata',publicItems);
 const gross=rent*12, yieldPct=value?gross/value*100:null, taxRate=value&&tax?tax/value*100:null;
 cards('metrics',[['Annual gross rent',rent?fmt(gross):'Enter rent'],['Gross rent yield',yieldPct!==null?yieldPct.toFixed(2)+'%':'Enter value and rent'],['Monthly property tax equivalent',tax?fmt(tax/12):'Not entered'],['Monthly insurance equivalent',insurance?fmt(insurance/12):'Not entered'],['Annual tax / estimated value',taxRate!==null?taxRate.toFixed(2)+'%':'Not available']]);
 const q=encodeURIComponent(address);const links=[['County assessor and parcel search','https://www.google.com/search?q='+q+'+county+assessor+parcel+search'],['County tax records','https://www.google.com/search?q='+q+'+property+tax+records'],['FEMA official flood map','https://msc.fema.gov/portal/search?Address='+q],['Google Maps location','https://www.google.com/maps/search/?api=1&query='+q],['HUD Fair Market Rent data','https://www.huduser.gov/portal/datasets/fmr.html'],['Census data profiles','https://data.census.gov/']];
 el('links').innerHTML=links.map(s=>link(s[0],s[1])).join('');
 if(geo?.coordinates){const x=geo.coordinates.x,y=geo.coordinates.y;el('maplink').innerHTML='<a target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps?q='+y+','+x+'">Open mapped property location ↗</a>'}else el('maplink').textContent='Map coordinates were not returned.';
 el('rnotes').textContent=el('notes').value.trim()||'No additional notes entered.';
 const summary='Preliminary Broker Pal property report for '+address+'\nProperty type: '+el('type').value+'\nEstimated value: '+(value?fmt(value):'Not entered')+'\nMonthly rent: '+(rent?fmt(rent):'Not entered')+'\nAnnual gross rent: '+(rent?fmt(gross):'Not available')+'\nGross yield: '+(yieldPct!==null?yieldPct.toFixed(2)+'%':'Not available')+'\nFEMA layer: '+flood+'\n\nThis report contains preliminary public data and user-entered estimates. Verify all information independently.';
 el('email').href='mailto:brian@yourbrokerpal.com?subject='+encodeURIComponent('Broker Pal Property Report: '+address)+'&body='+encodeURIComponent(summary);
 el('report').hidden=false;el('status').textContent='Report built. Automated public-data results are shown below; unavailable sources are identified rather than guessed.';el('report').scrollIntoView({behavior:'smooth'});
}
el('make').addEventListener('click',research);el('print').addEventListener('click',()=>window.print());
</script>
<style>
.tool{max-width:950px;margin:auto;padding:38px 22px 70px;color:#20374e}.kicker{font-size:11px;letter-spacing:2px;color:#078f9d;font-weight:800}.tool h1{font-size:clamp(38px,5vw,54px);color:#102b49;margin:12px 0}.lead{color:#63768a;line-height:1.7}.panel{background:#f0f5f6;padding:24px;border-top:4px solid #079eaa;display:grid;gap:15px;margin:25px 0}.panel label{font-size:13px;font-weight:700}.panel input,.panel select,.panel textarea{display:block;box-sizing:border-box;width:100%;padding:12px;margin-top:6px;border:1px solid #cbd8df;border-radius:4px;background:white;font-size:16px}.two{display:grid;grid-template-columns:1fr 1fr;gap:15px}.panel button,.cta{background:#078f9d;color:#102b49;border:0;padding:13px 18px;font-weight:800;text-decoration:none;width:max-content;cursor:pointer}.panel button:disabled{opacity:.6}.status,.muted,.disclaimer{font-size:12px;color:#718295;line-height:1.7}.report{border:1px solid #d7e2e7;padding:24px;margin-top:30px}.reporthead{display:flex;justify-content:space-between;gap:20px;align-items:center}.reporthead span{font-size:10px;letter-spacing:1.5px;color:#078f9d;font-weight:800}.report h2{font-size:25px;color:#102b49;margin:8px 0}.reporthead button{padding:10px;border:1px solid #b8cbd4;background:white}.section{margin:25px 0}.section h3{color:#102b49}.facts,.data-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.facts div,.data-grid div{background:#f0f5f6;padding:13px;min-width:0}.facts small,.data-grid small{display:block;color:#078f9d;font-size:12px}.facts b,.data-grid b{display:block;color:#102b49;overflow-wrap:anywhere;margin-top:4px}.report li{margin:9px 0}.report a{color:#078f9d}.disclaimer{margin:25px 0}.cta{display:inline-block}@media(max-width:650px){.two{grid-template-columns:1fr}.facts,.data-grid{grid-template-columns:1fr 1fr}.reporthead{align-items:flex-start;flex-direction:column}}@media print{header,footer,.panel,.kicker,.lead,.reporthead button,.cta{display:none!important}.report{border:0}.tool{padding:0}.facts,.data-grid{grid-template-columns:repeat(3,1fr)}}
</style>
</Layout>