---
import Layout from '../../layouts/BlogPost.astro';
---
<Layout title="Investment Loan Comparison Tool | Broker Pal" description="Compare investment property loan quotes side by side.">
<section class="tool"><p class="kicker">INVESTOR TOOLKIT</p><h1>Loan Comparison</h1><p class="lead">Put two financing quotes side by side. Enter the same loan scenario in both columns.</p>
<div class="compare"><div class="quote"><h2>Current lender quote</h2><label>Interest rate (%)<input id="r1" type="number" min="0" step=".01" inputmode="decimal" placeholder="Enter quoted rate"></label><label>Loan amount ($)<input id="a1" type="number" min="0" inputmode="decimal" placeholder="Enter loan amount"></label><label>Closing costs ($)<input id="c1" type="number" min="0" inputmode="decimal" placeholder="Enter closing costs"></label><label>Down payment ($)<input id="d1" type="number" min="0" inputmode="decimal" placeholder="Enter down payment"></label><label>Prepayment penalty<select id="p1"><option value="2">Not sure</option><option value="0">None</option><option value="1">Yes</option></select></label></div><div class="quote"><h2>Broker Pal option</h2><p class="quote-note">Enter the actual terms provided by Broker Pal. No sample rate or quote is assumed.</p><label>Interest rate (%)<input id="r2" type="number" min="0" step=".01" inputmode="decimal" placeholder="Enter quoted rate"></label><label>Loan amount ($)<input id="a2" type="number" min="0" inputmode="decimal" placeholder="Enter loan amount"></label><label>Closing costs ($)<input id="c2" type="number" min="0" inputmode="decimal" placeholder="Enter closing costs"></label><label>Down payment ($)<input id="d2" type="number" min="0" inputmode="decimal" placeholder="Enter down payment"></label><label>Prepayment penalty<select id="p2"><option value="2">Not sure</option><option value="0">None</option><option value="1">Yes</option></select></label></div></div>
<div class="out"><h2>Side-by-side estimate</h2><div class="outgrid"><div><small>Current lender monthly P&I</small><b id="m1">—</b><small>Estimated upfront costs + down payment</small><b id="u1">—</b></div><div><small>Broker Pal monthly P&I</small><b id="m2">—</b><small>Estimated upfront costs + down payment</small><b id="u2">—</b></div></div><p id="delta" aria-live="polite">Enter both quotes to compare the estimates.</p></div><p class="disclaimer">Illustrative 30-year amortization for comparison only; actual DSCR loan terms may have different amortization, interest-only periods, fees, reserves, prepayment terms, and lender requirements. Not a rate quote, commitment, or approval. Confirm all costs and terms with the lender.</p><a class="cta" href="/apply">Ask Broker Pal to review a quote →</a></section>
<script>
const ids=['r1','a1','c1','d1','p1','r2','a2','c2','d2','p2'];const raw=id=>document.getElementById(id).value.trim();const num=id=>Math.max(0,Number(raw(id))||0);const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
function payment(rate,amount){const i=rate/1200,n=360;return i?amount*i/(1-Math.pow(1+i,-n)):amount/n}
function update(){const complete=[1,2].every(x=>raw('r'+x)!==''&&raw('a'+x)!==''&&raw('c'+x)!==''&&raw('d'+x)!=='');if(!complete){['m1','u1','m2','u2'].forEach(id=>document.getElementById(id).textContent='—');document.getElementById('delta').textContent='Enter the rate, loan amount, closing costs, and down payment for both quotes to compare estimates.';return;}for(let x=1;x<=2;x++){const m=payment(num('r'+x),num('a'+x));document.getElementById('m'+x).textContent=money(m);document.getElementById('u'+x).textContent=money(num('c'+x)+num('d'+x))}const diff=payment(num('r1'),num('a1'))-payment(num('r2'),num('a2'));document.getElementById('delta').textContent='Estimated monthly P&I difference (current lender minus Broker Pal option): '+money(diff)+'. Prepayment penalty selections: '+(document.getElementById('p1').selectedOptions[0].text)+' / '+(document.getElementById('p2').selectedOptions[0].text)+'.'}
ids.forEach(id=>document.getElementById(id).addEventListener('input',update));ids.forEach(id=>document.getElementById(id).addEventListener('change',update));update();
</script>
</Layout>
<style>
.tool{max-width:1000px;margin:auto;padding:38px 22px 70px;color:#20374e}.kicker{font-size:11px;letter-spacing:2px;color:#078f9d;font-weight:800}.tool h1{font-size:clamp(38px,5vw,54px);color:#102b49;margin:12px 0}.lead{color:#63768a}.compare{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:28px 0}.quote{padding:22px;background:#f0f5f6;border-top:4px solid #079eaa}.quote h2,.out h2{font-size:21px;color:#102b49}.quote-note{font-size:12px;line-height:1.5;color:#63768a;margin:-5px 0 12px}.quote label{display:block;font-size:13px;font-weight:700;margin:14px 0}.quote input,.quote select{display:block;width:100%;box-sizing:border-box;padding:12px;margin-top:6px;border:1px solid #cbd8df;background:white;border-radius:4px;font-size:16px}.out{background:#102b49;color:white;padding:22px}.out h2{color:white}.outgrid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.outgrid>div{background:#1b3b56;padding:17px}.out small{display:block;color:#62c9bd;font-size:11px;margin:10px 0 4px}.out b{font-size:24px}.out p{color:#d2e1e8}.disclaimer{font-size:12px;color:#718295;line-height:1.7;margin:20px 0}.cta{display:inline-block;background:#078f9d;color:#102b49;text-decoration:none;font-weight:800;padding:13px 18px}@media(max-width:650px){.compare,.outgrid{grid-template-columns:1fr}}
</style>