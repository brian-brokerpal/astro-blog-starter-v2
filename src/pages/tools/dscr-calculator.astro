---
import Layout from '../../layouts/BlogPost.astro';
---
<Layout title="Free DSCR Calculator | broker pal" description="Estimate debt service coverage for an investment property.">
<section class="tool"><p class="kicker">INVESTOR TOOLKIT</p><h1>DSCR Calculator</h1><p class="lead">Estimate whether a property's rental income covers its monthly debt service.</p>
<div class="panel"><label>Monthly gross rent ($)<input id="rent" type="number" min="0" value="2500"></label><label>Other monthly income ($)<input id="other" type="number" min="0" value="0"></label><label>Monthly PITIA / debt service ($)<input id="debt" type="number" min="0" value="1900"></label><label>Monthly operating expenses, excluding debt ($)<input id="expenses" type="number" min="0" value="250"></label><div class="result"><small>ESTIMATED DSCR</small><strong id="ratio">1.18x</strong><p id="summary">Income divided by debt service.</p></div><div class="metrics"><div><small>Net operating income</small><b id="noi">$2,250</b></div><div><small>Monthly cash flow after debt</small><b id="cash">$350</b></div><div><small>Rent needed at 1.00x</small><b id="breakEven">$2,150</b></div></div><button id="reset" type="button">Reset example</button></div><p class="disclaimer">Estimate only. Lenders calculate DSCR differently and may use gross rent, net operating income, PITIA, or other qualifying methods. This is not a loan approval or offer.</p><a class="cta" href="/apply">Discuss your scenario →</a></section>
<script>
const ids=['rent','other','debt','expenses']; const fmt=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
function calc(){const v=Object.fromEntries(ids.map(id=>[id,Math.max(0,Number(document.getElementById(id).value)||0)]));const noi=v.rent+v.other-v.expenses;const ratio=v.debt>0?noi/v.debt:0;document.getElementById('ratio').textContent=v.debt?ratio.toFixed(2)+'x':'—';document.getElementById('summary').textContent=v.debt?(ratio>=1?'Estimated income covers the entered debt service.':'Estimated income is below the entered debt service.'):'Enter monthly debt service to calculate.';document.getElementById('noi').textContent=fmt(noi);document.getElementById('cash').textContent=fmt(noi-v.debt);document.getElementById('breakEven').textContent=fmt(Math.max(0,v.debt+v.expenses-v.other));}
ids.forEach(id=>document.getElementById(id).addEventListener('input',calc));document.getElementById('reset').addEventListener('click',()=>{[2500,0,1900,250].forEach((v,i)=>document.getElementById(ids[i]).value=v);calc()});calc();
</script>
</Layout>
<style>
.tool{max-width:850px;margin:auto;padding:38px 22px 70px;color:#20374e}.kicker{font-size:11px;letter-spacing:2px;color:#078f9d;font-weight:800}.tool h1{font-size:clamp(38px,5vw,54px);color:#102b49;margin:12px 0}.lead{color:#63768a;font-size:17px}.panel{background:#f0f5f6;padding:26px;border-top:4px solid #079eaa;margin-top:28px;display:grid;grid-template-columns:1fr 1fr;gap:18px}.panel label{font-size:13px;font-weight:700;color:#334c63}.panel input{display:block;width:100%;box-sizing:border-box;padding:13px;margin-top:7px;border:1px solid #cbd8df;border-radius:4px;font-size:16px;background:white}.result{grid-column:1/-1;background:#102b49;color:white;padding:22px}.result small,.metrics small{display:block;font-size:10px;letter-spacing:1.5px;color:#62c9bd}.result strong{font-size:42px}.result p{margin:0;color:#d0dce5}.metrics{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.metrics div{background:white;padding:15px}.metrics small{color:#078f9d;letter-spacing:0}.metrics b{display:block;margin-top:7px;color:#102b49;font-size:18px}.panel button,.cta{border:0;background:#078f9d;color:#102b49;font-weight:800;padding:13px 18px;text-decoration:none;width:max-content;cursor:pointer}.disclaimer{font-size:12px;color:#718295;line-height:1.7;margin:20px 0}.cta{display:inline-block}@media(max-width:600px){.panel{grid-template-columns:1fr}.result,.metrics{grid-column:1}.metrics{grid-template-columns:1fr}}
</style>