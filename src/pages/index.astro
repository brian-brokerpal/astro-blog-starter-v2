---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!doctype html>
<html lang="en"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/></head><body><Header/>
<main class="home">
<section class="hero"><div class="hero-copy"><div class="eyebrow"><span></span> DSCR INVESTMENT PROPERTY FINANCING</div><h1>Finance your next investment.<em> Move with confidence.</em></h1><p class="lead">Real estate investors need financing that understands the investment. YourBrokerPal helps make the DSCR loan process clearer, more responsive, and focused on your next move.</p><div class="actions"><a class="button primary" href="/apply">Start a Loan Inquiry <span>↗</span></a><a class="button secondary" href="/how-it-works">How It Works</a></div><div class="hero-note">Purchase · Rate & Term Refinance · Cash-Out Refinance</div></div><div class="hero-art"><div class="art-label">INVESTOR-FOCUSED FINANCING</div><div class="building"><div class="sun"></div><div class="tower t1"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="tower t2"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="house"><i></i><i></i><i></i></div><div class="ground"></div></div><div class="art-caption"><b>Built around the property.</b><span>Focused on the investor.</span></div></div></section>
<section class="trust"><div><b>01</b><span>Investor-minded<br/>loan guidance</span></div><div><b>02</b><span>Clear next steps<br/>and communication</span></div><div><b>03</b><span>Financing options for<br/>rental properties</span></div></section>
<section class="intro"><div class="section-kicker">A BETTER WAY TO MOVE FORWARD</div><h2>Your investment strategy deserves a lending partner who gets it.</h2><p>Whether you're acquiring your next rental or refinancing a property already in your portfolio, we help you navigate the DSCR financing process with practical guidance and a personal point of contact.</p><a class="text-link" href="/about">Get to know YourBrokerPal <span>→</span></a></section>
<section class="steps"><div><div class="section-kicker">SIMPLE. DIRECT. INVESTOR-FOCUSED.</div><h2>From first conversation to closing.</h2></div><div class="step-grid"><article><b>01</b><h3>Tell us about the property</h3><p>Share the basics of your investment and financing goals.</p></article><article><b>02</b><h3>Review your options</h3><p>We help identify a path that fits the property and your objectives.</p></article><article><b>03</b><h3>Move toward closing</h3><p>Stay informed on next steps as your loan moves through the process.</p></article></div><a class="button primary" href="/how-it-works">Explore the process <span>↗</span></a></section>
<section class="closing"><div><div class="section-kicker">READY FOR YOUR NEXT INVESTMENT?</div><h2>Let's talk about your next property.</h2><p>Start with a quick inquiry. We'll connect with you about the property and financing you're considering.</p></div><a class="button light" href="/apply">Get Started <span>↗</span></a></section>
</main><Footer/></body></html>
<style>
:global(body){background:#f7f8fa;color:#172b42;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6}:global(main.home){width:100%;max-width:100%;padding:0;margin:0}.hero{max-width:1180px;margin:auto;padding:76px 28px 66px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:58px;min-height:510px}.eyebrow,.section-kicker{font-size:11px;font-weight:800;letter-spacing:2px;color:#a47a3e}.eyebrow{display:flex;align-items:center;gap:10px}.eyebrow span{width:25px;height:2px;background:#c59a58}.hero h1{font-size:clamp(42px,5vw,66px);line-height:1.05;letter-spacing:-2.8px;color:#10243c;margin:22px 0}.hero h1 em{display:block;color:#b58a4c;font-style:normal}.lead{max-width:560px;color:#596b7e;font-size:18px;line-height:1.75}.actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:28px}.button{display:inline-flex;align-items:center;gap:20px;text-decoration:none;font-weight:750;font-size:14px;padding:14px 20px;border-radius:4px}.primary{background:#c59a58;color:#10243c}.secondary{border:1px solid #cbd3dc;color:#1b344f}.hero-note{font-size:12px;color:#788797;margin-top:23px;letter-spacing:.3px}.hero-art{min-height:390px;background:#e7edf1;border-radius:5px;position:relative;overflow:hidden;padding:28px}.art-label{font-size:10px;letter-spacing:2px;color:#53697c;font-weight:800;position:relative;z-index:2}.building{position:absolute;inset:55px 0 0;background:linear-gradient(145deg,#e8edf0,#cbd8df);overflow:hidden}.sun{position:absolute;width:140px;height:140px;border-radius:50%;background:#d9b77e;right:55px;top:20px;opacity:.85}.tower{position:absolute;bottom:55px;background:#526b7c;display:flex;gap:10px;padding:20px 12px 0;box-shadow:inset 0 0 0 5px #40596b}.tower i{width:13px;height:20px;background:#d8c7a4;margin-bottom:16px}.t1{height:190px;width:135px;left:80px}.t2{height:245px;width:150px;left:225px;background:#29445c}.house{position:absolute;right:40px;bottom:55px;width:170px;height:100px;background:#f5f1e8;border-top:10px solid #a77c4c;clip-path:polygon(0 20%,50% 0,100% 20%,100% 100%,0 100%)}.house i{position:relative;display:inline-block;background:#8ba0aa;width:27px;height:35px;margin:42px 12px 0 20px}.ground{position:absolute;bottom:0;height:55px;background:#879d91;width:100%}.art-caption{position:absolute;bottom:23px;left:28px;background:#fff;padding:13px 18px;display:grid;box-shadow:0 8px 30px #24384a18}.art-caption b{font-size:13px;color:#10243c}.art-caption span{font-size:11px;color:#758496}.trust{background:#10243c;color:#fff;display:flex;justify-content:center;gap:clamp(25px,8vw,110px);padding:27px 24px}.trust div{display:flex;align-items:center;gap:14px}.trust b{font-size:23px;color:#d6ad6d}.trust span{font-size:12px;line-height:1.4;color:#d6e0e9}.intro{max-width:800px;margin:auto;text-align:center;padding:90px 28px}.intro h2,.steps h2,.closing h2{font-size:clamp(30px,3.5vw,43px);line-height:1.15;letter-spacing:-1.4px;color:#10243c;margin:16px 0}.intro p{color:#647588;font-size:16px;line-height:1.8}.text-link{display:inline-block;color:#a47a3e;font-size:14px;font-weight:800;text-decoration:none;margin-top:12px}.steps{background:#edf1f4;padding:75px max(28px,calc((100% - 1120px)/2))}.steps h2{max-width:440px}.step-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin:35px 0}.step-grid article{background:#fff;padding:27px;border-top:3px solid #c59a58}.step-grid article>b{color:#b58a4c;font-size:13px}.step-grid h3{font-size:19px;color:#10243c;margin:14px 0 8px}.step-grid p{font-size:14px;color:#68798b;margin:0}.closing{background:#183550;color:#fff;padding:55px max(28px,calc((100% - 1120px)/2));display:flex;justify-content:space-between;align-items:center;gap:25px}.closing h2{color:#fff;margin-bottom:10px}.closing p{color:#c3d0dc;margin:0;max-width:590px}.closing .section-kicker{color:#d9b77e}.light{background:#fff;color:#10243c;white-space:nowrap}@media(max-width:800px){.hero{grid-template-columns:1fr;padding-top:48px;gap:35px}.hero-art{min-height:320px}.trust{gap:20px;flex-wrap:wrap;justify-content:flex-start}.trust div{min-width:40%}.step-grid{grid-template-columns:1fr}.closing{align-items:flex-start;flex-direction:column}.intro{padding:65px 25px}}@media(max-width:460px){.hero h1{font-size:43px}.hero-art{min-height:280px}.t1{left:25px}.t2{left:150px}.house{right:10px;width:130px}.trust div{min-width:100%}}
</style>