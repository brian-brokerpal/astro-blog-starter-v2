---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!doctype html>
<html lang="en"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/></head><body><Header/>
<main class="home">
<section class="hero"><div class="hero-copy"><div class="eyebrow"><span></span> INVESTMENT LOANS</div><h1>Finance your next investment.<em> Move with confidence.</em></h1><p class="lead">Real estate investors need financing that understands the investment. broker pal helps make the DSCR loan process clearer, more responsive, and focused on your next move.</p><div class="actions"><a class="button primary" href="/apply">Start a Loan Inquiry <span>↗</span></a><a class="button secondary" href="/how-it-works">How It Works</a></div><div class="hero-note">Purchase · Rate & Term Refinance · Cash-Out Refinance</div></div><div class="hero-art" role="img" aria-label="Broker Pal investment property financing visual in navy and teal">
  <div class="visual-top"><span class="visual-kicker">REAL ESTATE INVESTMENT FINANCING</span><span class="visual-index">01 / INVESTOR TOOLKIT</span></div>
  <div class="visual-main">
    <div class="visual-copy"><span class="visual-rule"></span><div class="visual-brand">BROKER <strong>PAL</strong></div><h2>Capital for<br/><em>what's next.</em></h2><p>Financing built around the property.<br/>Guidance built around you.</p></div>
    <svg class="city-art" viewBox="0 0 440 390" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs><linearGradient id="towerA" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#24465c"/><stop offset="1" stop-color="#10283d"/></linearGradient><linearGradient id="towerB" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#326b78"/><stop offset="1" stop-color="#17394d"/></linearGradient><linearGradient id="glow" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#52d1c3" stop-opacity=".34"/><stop offset="1" stop-color="#52d1c3" stop-opacity="0"/></linearGradient></defs>
      <circle cx="305" cy="112" r="112" fill="url(#glow)"/><path d="M0 330H440" stroke="#4dc8bd" stroke-opacity=".55" stroke-width="2"/>
      <path d="M24 330V164l70-37 70 37v166Z" fill="url(#towerA)" stroke="#4b8390" stroke-opacity=".7"/>
      <path d="M166 330V86l77-34 78 34v244Z" fill="url(#towerB)" stroke="#68cfc2" stroke-opacity=".75"/>
      <path d="M321 330V157l51-26 50 26v173Z" fill="url(#towerA)" stroke="#4b8390" stroke-opacity=".7"/>
      <g fill="#7ce0d5" opacity=".76"><path d="M43 181h20v16H43zm35-19h20v16H78zm-35 53h20v16H43zm35 0h20v16H78zm-35 53h20v16H43zm35 0h20v16H78z"/><path d="M190 104h22v18h-22zm40-17h22v18h-22zm40 17h22v18h-22zm-80 45h22v18h-22zm40 0h22v18h-22zm40 0h22v18h-22zm-80 45h22v18h-22zm40 0h22v18h-22zm40 0h22v18h-22zm-80 45h22v18h-22zm40 0h22v18h-22zm40 0h22v18h-22z"/><path d="M342 176h17v15h-17zm32-15h17v15h-17zm-32 48h17v15h-17zm32 0h17v15h-17zm-32 48h17v15h-17zm32 0h17v15h-17z"/></g>
      <path d="M0 330h440v60H0z" fill="#0b1d30"/><path d="M20 350h400" stroke="#4dc8bd" stroke-opacity=".35"/><path d="M170 330V48l73-32 78 32" fill="none" stroke="#7ce0d5" stroke-opacity=".65" stroke-width="1.5"/>
      <path d="M24 365h90m16 0h44m20 0h70m20 0h58m20 0h40" stroke="#4dc8bd" stroke-opacity=".4" stroke-width="2"/>
    </svg>
  </div>
  <div class="visual-bottom"><span>DSCR · RENTAL · BUSINESS PURPOSE</span><span class="visual-dot"></span><span>MOVE WITH CONFIDENCE</span></div>
</div></section>
<section class="report-promo"><div class="report-promo-inner"><div class="report-promo-copy"><div class="report-promo-kicker">FREE PROPERTY REPORT</div><h2>Know more before you make an offer.</h2><p>Create your own property report with an estimated value, available comparable properties, and useful property research. Then save or print your report as a PDF and move forward with more confidence.</p><a class="report-promo-button" href="/tools/property-report">Create My Free Property Report <span>↗</span></a><small>Free to use · No obligation · Property research, not an appraisal</small></div><div class="report-promo-mark" aria-hidden="true"><div class="report-sheet"><span>PROPERTY REPORT</span><b>PROPERTY<br/>AT A GLANCE</b><i></i><i></i><i></i><strong>PDF</strong></div></div></div></section>
<section class="toolkit"><div class="section-kicker">BROKER PAL INVESTOR TOOLKIT</div><h2>Make the next move with better information.</h2><p>Free tools to evaluate a property, understand a DSCR scenario, and compare financing options.</p><div class="toolkit-grid"><a href="/tools/dscr-calculator"><b>DSCR Calculator</b><span>Estimate coverage, NOI and cash flow ↗</span></a><a href="/tools/loan-comparison"><b>Loan Comparison</b><span>Compare rate, costs, down payment and prepayment ↗</span></a><a href="/tools/property-report"><b>Property Data Report</b><span>Build a printable property worksheet and research public records ↗</span></a><a href="/community"><b>Opportunity Circle</b><span>Meet the people behind the investment ↗</span></a></div></section>
<section class="trust"><div><b>01</b><span>Investor-minded<br/>loan guidance</span></div><div><b>02</b><span>Clear next steps<br/>and communication</span></div><div><b>03</b><span>Financing options for<br/>rental properties</span></div></section>
<section class="intro"><div class="section-kicker">A BETTER WAY TO MOVE FORWARD</div><h2>Your investment strategy deserves a lending partner who gets it.</h2><p>Whether you're acquiring your next rental or refinancing a property already in your portfolio, we help you navigate the DSCR financing process with practical guidance and a personal point of contact.</p><a class="text-link" href="/about">Get to know broker pal <span>→</span></a></section>
<section class="programs"><div class="section-kicker">FINANCING BUILT FOR INVESTORS</div><h2>Investment loan programs</h2><p class="program-intro">Explore financing paths for income-producing properties and business-purpose real estate projects.</p><div class="program-grid"><article><span>01</span><h3>DSCR Rental Loans</h3><p>Financing options for rental properties with a focus on property cash flow and rental income.</p><a href="/apply">Discuss a rental loan ↗</a></article><article><span>02</span><h3>Fix &amp; Flip</h3><p>Business-purpose financing options for eligible renovation and resale projects.</p><a href="/apply">Discuss a project ↗</a></article><article><span>03</span><h3>Commercial &amp; Business Purpose</h3><p>Explore financing for qualifying investment and commercial real estate needs.</p><a href="/apply">Start a conversation ↗</a></article></div></section>
<section class="steps"><div><div class="section-kicker">SIMPLE. DIRECT. INVESTOR-FOCUSED.</div><h2>From first conversation to closing.</h2></div><div class="step-grid"><article><b>01</b><h3>Tell us about the property</h3><p>Share the basics of your investment and financing goals.</p></article><article><b>02</b><h3>Review your options</h3><p>We help identify a path that fits the property and your objectives.</p></article><article><b>03</b><h3>Move toward closing</h3><p>Stay informed on next steps as your loan moves through the process.</p></article></div><a class="button primary" href="/how-it-works">Explore the process <span>↗</span></a></section>

<section class="closing"><div><div class="section-kicker">READY FOR YOUR NEXT INVESTMENT?</div><h2>Let's talk about your next property.</h2><p>Start with a quick inquiry. We'll connect with you about the property and financing you're considering.</p></div><a class="button light" href="/apply">Get Started <span>↗</span></a></section>
</main><Footer/></body></html>
<style>
:global(body){background:#f7f8fa;color:#172b42;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6}:global(main.home){width:100%;max-width:100%;padding:0;margin:0}.hero{max-width:1180px;margin:auto;padding:76px 28px 66px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:58px;min-height:510px}.eyebrow,.section-kicker{font-size:11px;font-weight:800;letter-spacing:2px;color:#078f9d}.eyebrow{display:flex;align-items:center;gap:10px}.eyebrow span{width:25px;height:2px;background:#078f9d}.hero h1{font-size:clamp(42px,5vw,66px);line-height:1.05;letter-spacing:-2.8px;color:#10243c;margin:22px 0}.hero h1 em{display:block;color:#079eaa;font-style:normal}.lead{max-width:560px;color:#596b7e;font-size:18px;line-height:1.75}.actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:28px}.button{display:inline-flex;align-items:center;gap:20px;text-decoration:none;font-weight:750;font-size:14px;padding:14px 20px;border-radius:4px}.primary{background:#078f9d;color:#10243c}.secondary{border:1px solid #c8d8df;color:#1b344f}.hero-note{font-size:12px;color:#788797;margin-top:23px;letter-spacing:.3px}.hero-art{min-height:390px;background:radial-gradient(circle at 78% 28%,#1d5261 0,#102b43 38%,#0b1d30 78%);border-radius:8px;position:relative;overflow:hidden;padding:25px 27px;color:#fff;box-shadow:0 22px 55px #102b4924}.hero-art:after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 45%,#51cfc21a 100%);pointer-events:none}.visual-top,.visual-bottom{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:12px}.visual-kicker,.visual-index,.visual-bottom{font-size:9px;letter-spacing:1.6px;font-weight:800;color:#b8d2d9}.visual-index{color:#6dd7cb}.visual-main{position:relative;display:flex;align-items:center;min-height:285px}.visual-copy{position:relative;z-index:2;width:58%;padding:18px 0}.visual-rule{display:block;width:38px;height:3px;background:#58d0c3;margin-bottom:20px}.visual-brand{font-size:15px;letter-spacing:3px;font-weight:800;color:#fff}.visual-brand strong{color:#65d6c9}.visual-copy h2{font-size:clamp(34px,4vw,48px);line-height:.98;letter-spacing:-1.8px;color:#fff;margin:20px 0 15px}.visual-copy h2 em{font-style:normal;color:#69d7ca}.visual-copy p{font-size:12px;line-height:1.7;color:#c4d9df}.city-art{position:absolute;width:69%;height:100%;right:-6%;bottom:0;opacity:.96}.visual-bottom{border-top:1px solid #6dd7cb45;padding-top:14px;font-size:8px;color:#c1d7dd}.visual-dot{width:5px;height:5px;background:#6dd7cb;border-radius:50%;flex:0 0 5px}.trust{background:#10243c;color:#fff;display:flex;justify-content:center;gap:clamp(25px,8vw,110px);padding:27px 24px}.trust div{display:flex;align-items:center;gap:14px}.trust b{font-size:23px;color:#62c9bd}.trust span{font-size:12px;line-height:1.4;color:#d6e0e9}.intro{max-width:800px;margin:auto;text-align:center;padding:90px 28px}.intro h2,.steps h2,.closing h2{font-size:clamp(30px,3.5vw,43px);line-height:1.15;letter-spacing:-1.4px;color:#10243c;margin:16px 0}.intro p{color:#647588;font-size:16px;line-height:1.8}.text-link{display:inline-block;color:#078f9d;font-size:14px;font-weight:800;text-decoration:none;margin-top:12px}.steps{background:#edf5f6;padding:75px max(28px,calc((100% - 1120px)/2))}.steps h2{max-width:440px}.step-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin:35px 0}.step-grid article{background:#fff;padding:27px;border-top:3px solid #078f9d}.step-grid article>b{color:#079eaa;font-size:13px}.step-grid h3{font-size:19px;color:#10243c;margin:14px 0 8px}.step-grid p{font-size:14px;color:#68798b;margin:0}.toolkit{max-width:1124px;margin:auto;padding:78px 28px}.toolkit h2{font-size:clamp(30px,3.5vw,43px);line-height:1.15;letter-spacing:-1.4px;color:#10243c;margin:14px 0}.toolkit>p{color:#647588}.toolkit-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;margin-top:28px}.toolkit-grid a{display:grid;gap:7px;padding:23px;background:#fff;border:1px solid #dce7eb;border-left:4px solid #079eaa;text-decoration:none}.toolkit-grid b{font-size:18px;color:#10243c}.toolkit-grid span{font-size:13px;color:#647588}@media(max-width:650px){.toolkit-grid{grid-template-columns:1fr}}.closing{background:#183550;color:#fff;padding:55px max(28px,calc((100% - 1120px)/2));display:flex;justify-content:space-between;align-items:center;gap:25px}.closing h2{color:#fff;margin-bottom:10px}.closing p{color:#c3d0dc;margin:0;max-width:590px}.closing .section-kicker{color:#62c9bd}.light{background:#fff;color:#10243c;white-space:nowrap}@media(max-width:800px){.hero{grid-template-columns:1fr;padding-top:48px;gap:35px}.hero-art{min-height:320px}.visual-main{min-height:225px}.city-art{width:70%;right:-12%}.visual-copy{width:65%}.trust{gap:20px;flex-wrap:wrap;justify-content:flex-start}.trust div{min-width:40%}.step-grid{grid-template-columns:1fr}.closing{align-items:flex-start;flex-direction:column}.intro{padding:65px 25px}}@media(max-width:460px){.hero h1{font-size:43px}.hero-art{min-height:280px;padding:20px}.visual-main{min-height:205px}.visual-copy h2{font-size:34px}.city-art{width:78%;right:-22%;opacity:.72}.visual-index{display:none}.visual-bottom{font-size:7px;letter-spacing:1px}.t1{left:25px}.t2{left:150px}.house{right:10px;width:130px}.trust div{min-width:100%}}
.programs{padding:78px 28px;max-width:1180px;margin:auto}.programs h2{font-size:clamp(30px,3.5vw,43px);line-height:1.15;letter-spacing:-1.4px;color:#10243c;margin:14px 0}.program-intro{color:#647588;max-width:650px}.program-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:30px}.program-grid article{padding:27px;background:#fff;border:1px solid #e1e9ed;border-top:3px solid #078f9d}.program-grid article>span{color:#079eaa;font-size:13px;font-weight:800}.program-grid h3{color:#10243c;font-size:20px;margin:13px 0 8px}.program-grid p{color:#68798b;font-size:14px;min-height:70px}.program-grid a{color:#078f9d;font-size:13px;font-weight:800;text-decoration:none}@media(max-width:760px){.program-grid{grid-template-columns:1fr}.program-grid p{min-height:0}}\n.report-promo{background:linear-gradient(115deg,#10243c,#1c5261);color:#fff;padding:44px 28px}.report-promo-inner{max-width:1124px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:35px}.report-promo-copy{max-width:760px}.report-promo-kicker{font-size:11px;font-weight:800;letter-spacing:2px;color:#62c9bd}.report-promo h2{font-size:clamp(29px,3.3vw,40px);line-height:1.12;letter-spacing:-1.2px;color:#fff;margin:10px 0}.report-promo p{font-size:15px;line-height:1.7;color:#d6e3e9;max-width:690px;margin:0 0 20px}.report-promo-button{display:inline-flex;align-items:center;gap:18px;padding:14px 19px;background:#62c9bd;color:#10243c;text-decoration:none;font-size:14px;font-weight:800;border-radius:4px}.report-promo small{display:block;margin-top:12px;color:#c3d0dc;font-size:11px}.report-promo-mark{width:150px;height:175px;flex:0 0 150px;display:grid;place-items:center}.report-sheet{position:relative;width:118px;height:150px;background:#fff;color:#10243c;padding:14px 12px;box-shadow:8px 8px 0 #62c9bd;transform:rotate(4deg)}.report-sheet span{font-size:7px;letter-spacing:1px;color:#078f9d;font-weight:800}.report-sheet b{display:block;font-size:14px;line-height:1.1;margin:13px 0}.report-sheet i{display:block;height:4px;background:#dce7eb;margin:7px 0;width:90%}.report-sheet i:nth-of-type(2){width:70%}.report-sheet i:nth-of-type(3){width:82%}.report-sheet strong{position:absolute;right:10px;bottom:9px;font-size:10px;color:#078f9d}@media(max-width:650px){.report-promo{padding:36px 24px}.report-promo-inner{gap:10px}.report-promo-mark{width:90px;flex-basis:90px;transform:scale(.8);transform-origin:center right}.report-promo-button{font-size:13px;padding:13px 14px}}</style>