---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Welcome to Broker Pal</h1>
			<p>Your trusted partner for DSCR real estate investment financing. Finance your next investment property with a streamlined loan process, clear communication, and investor-focused solutions. Apply Now </p>
		</main>
		<Footer />
	</body>
</html>
