p-path:polygon(0 20%,50% 0,100% 20%,100% 100%,0 100%)}.house i{position:relative;display:inline-block;background:#8ba0aa;width:27px;height:35px;margin:42px 12px 0 20px}.ground{position:absolute;bottom:0;height:55px;background:#879d91;width:100%}.art-caption{position:absolute;bottom:23px;left:28px;background:#fff;padding:13px 18px;display:grid;box-shadow:0 8px 30px #24384a18}.art-caption b{font-size:13px;color:#10243c}.art-caption span{font-size:11px;color:#758496}.trust{background:#10243c;color:#fff;display:flex;justify-content:center;gap:clamp(25px,8vw,110px);padding:27px 24px}.trust div{display:flex;align-items:center;gap:14px}.trust b{font-size:23px;color:#62c9bd}.trust span{font-size:12px;line-height:1.4;color:#d6e0e9}.intro{max-width:800px;margin:auto;text-align:center;padding:90px 28px}.intro h2,.steps h2,.closing h2{font-size:clamp(30px,3.5vw,43px);line-height:1.15;letter-spacing:-1.4px;color:#10243c;margin:16px 0}.intro p{color:#647588;font-size:16px;line-height:1.8}.text-link{display:inline-block;color:#078f9d;font-size:14px;font-weight:800;text-decoration:none;margin-top:12px}.steps{background:#edf5f6;padding:75px max(28px,calc((100% - 1120px)/2))}.steps h2{max-width:440px}.step-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin:35px 0}.step-grid article{background:#fff;padding:27px;border-top:3px solid #078f9d}.step-grid article>b{color:#079eaa;font-size:13px}.step-grid h3{font-size:19px;color:#10243c;margin:14px 0 8px}.step-grid p{font-size:14px;color:#68798b;margin:0}.toolkit{max-width:1124px;margin:auto;padding:78px 28px}.toolkit h2{font-size:clamp(30px,3.5vw,43px);line-height:1.15;letter-spacing:-1.4px;color:#10243c;margin:14px 0}.toolkit>p{color:#647588}.toolkit-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;margin-top:28px}.toolkit-grid a{display:grid;gap:7px;padding:23px;background:#fff;border:1px solid #dce7eb;border-left:4px solid #079eaa;text-decoration:none}.toolkit-grid b{font-size:18px;color:#10243c}.toolkit-grid span{font-size:13px;color:#647588}@media(max-width:650px){.toolkit-grid{grid-template-columns:1fr}}.closing{background:#183550;color:#fff;padding:55px max(28px,calc((100% - 1120px)/2));display:flex;justify-content:space-between;align-items:center;gap:25px}.closing h2{color:#fff;margin-bottom:10px}.closing p{color:#c3d0dc;margin:0;max-width:590px}.closing .section-kicker{color:#62c9bd}.light{background:#fff;color:#10243c;white-space:nowrap}@media(max-width:800px){.hero{grid-template-columns:1fr;padding-top:48px;gap:35px}.hero-art{min-height:320px}.trust{gap:20px;flex-wrap:wrap;justify-content:flex-start}.trust div{min-width:40%}.step-grid{grid-template-columns:1fr}.closing{align-items:flex-start;flex-direction:column}.intro{padding:65px 25px}}@media(max-width:460px){.hero h1{font-size:43px}.hero-art{min-height:280px}.t1{left:25px}.t2{left:150px}.house{right:10px;width:130px}.trust div{min-width:100%}}
.programs{padding:78px 28px;max-width:1180px;margin:auto}.programs h2{font-size:clamp(30px,3.5vw,43px);line-height:1.15;letter-spacing:-1.4px;color:#10243c;margin:14px 0}.program-intro{color:#647588;max-width:650px}.program-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:30px}.program-grid article{padding:27px;background:#fff;border:1px solid #e1e9ed;border-top:3px solid #078f9d}.program-grid article>span{color:#079eaa;font-size:13px;font-weight:800}.program-grid h3{color:#10243c;font-size:20px;margin:13px 0 8px}.program-grid p{color:#68798b;font-size:14px;min-height:70px}.program-grid a{color:#078f9d;font-size:13px;font-weight:800;text-decoration:none}@media(max-width:760px){.program-grid{grid-template-columns:1fr}.program-grid p{min-height:0}}\n.report-promo{background:linear-gradient(115deg,#10243c,#1c5261);color:#fff;padding:44px 28px}.report-promo-inner{max-width:1124px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:35px}.report-promo-copy{max-width:760px}.report-promo-kicker{font-size:11px;font-weight:800;letter-spacing:2px;color:#62c9bd}.report-promo h2{font-size:clamp(29px,3.3vw,40px);line-height:1.12;letter-spacing:-1.2px;color:#fff;margin:10px 0}.report-promo p{font-size:15px;line-height:1.7;color:#d6e3e9;max-width:690px;margin:0 0 20px}.report-promo-button{display:inline-flex;align-items:center;gap:18px;padding:14px 19px;background:#62c9bd;color:#10243c;text-decoration:none;font-size:14px;font-weight:800;border-radius:4px}.report-promo small{display:block;margin-top:12px;color:#c3d0dc;font-size:11px}.report-promo-mark{width:150px;height:175px;flex:0 0 150px;display:grid;place-items:center}.report-sheet{position:relative;width:118px;height:150px;background:#fff;color:#10243c;padding:14px 12px;box-shadow:8px 8px 0 #62c9bd;transform:rotate(4deg)}.report-sheet span{font-size:7px;letter-spacing:1px;color:#078f9d;font-weight:800}.report-sheet b{display:block;font-size:14px;line-height:1.1;margin:13px 0}.report-sheet i{display:block;height:4px;background:#dce7eb;margin:7px 0;width:90%}.report-sheet i:nth-of-type(2){width:70%}.report-sheet i:nth-of-type(3){width:82%}.report-sheet strong{position:absolute;right:10px;bottom:9px;font-size:10px;color:#078f9d}@media(max-width:650px){.report-promo{padding:36px 24px}.report-promo-inner{gap:10px}.report-promo-mark{width:90px;flex-basis:90px;transform:scale(.8);transform-origin:center right}.report-promo-button{font-size:13px;padding:13px 14px}}</style>