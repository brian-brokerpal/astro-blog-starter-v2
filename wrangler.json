{
  "name": "astro-blog-starter-v2",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "PROPERTY_USAGE_DB",
      "database_name": "yourbrokerpal-property-usage",
      "database_id": "3089c709-9f68-4740-b15e-2c7d6060a0b6",
      "migrations_dir": "migrations"
    }
  ]
}
